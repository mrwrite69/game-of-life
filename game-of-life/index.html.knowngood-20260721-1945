  if(!m||!m.active) return;
  const todayStr = todayKey();
  if(m.lastLoggedDay === todayStr){ showToast('Already logged today! 🟣'); return; }
  m.lastLoggedDay = todayStr;
  todayChecked['mission_'+id] = (todayChecked['mission_'+id]||0)+1;
  autosave();
  updatePointsUI();
  soundTap();
  showToast('Mission progress logged! 🟣');
  renderMissions();
  renderMissionHub();
}

function abandonMission(id){
  const m=missions.find(x=>x.id===id);if(!m)return;
  if(!confirm('Abandon this mission?'))return;
  m.active=false;m.startDate=null;m.progress=0;
  debouncedSave();renderMissions();showToast('Mission abandoned');
}

function updateMissionProgress(){
  missions.filter(m=>m.active&&!m.completed).forEach(m=>{
    if(!m.startDate)return;
    const start=new Date(m.startDate);
    // Missions with linked activities: count days where any linked activity was logged
    if(m.linkedActivities && m.linkedActivities.length > 0){
      const linkedNames=m.linkedActivities.map(a=>a.name);
      const progressDays=Object.entries(data).filter(([k,v])=>{
        const kd=new Date(k);
        return kd>=start&&v.activities&&v.activities.some(a=>linkedNames.includes(a.name)&&(a.count||0)>0);
      }).length;
      m.progress=Math.min(m.days,progressDays);
    // NaNoWriMo (m16): count days where ANY writing activity was logged
    } else if(m.id==='m16'){
      const writingDays=Object.entries(data).filter(([k,v])=>{
        const kd=new Date(k);
        return kd>=start&&v.activities&&v.activities.some(a=>a.name&&a.name.toLowerCase().includes('writ'));
      }).length;
      m.progress=Math.min(m.days,writingDays);
    } else {
      const tk2=todayKey();
      const passDaysInRange=Object.entries(data).filter(([k,v])=>{
        const kd=new Date(k);
        if(!(kd>=start))return false;
        if(v.restDay)return true;
        if(k===tk2)return v.pts>=getThresholds().pass&&v.locked;
        return v.pts>=getThresholds().pass;
      }).length;
      m.progress=Math.min(m.days,passDaysInRange);
    }
    if(m.progress>=m.days){m.completed=true;m.active=false;showToast(`Mission Complete: ${m.name}! 🏆`);soundAchieve();launchFireworks(80);if(restDaySettings.missionComplete&&getBankedRestDays().length<2)earnRestDay(`Mission complete: ${m.name} 🎯`);}
  });
  debouncedSave();
}

function renderMissions(){
