// ─── HIGH SCORES ──────────────────────────────────────────────────────────────
function getHistoricalStreaks() {
  const t = getThresholds();
  const passDays = Object.keys(data)
    .filter(k => { const v = data[k]; if(!v) return false; if(v.restDay) return true; if(k===todayKey()) return v.pts>=t.pass&&v.locked; return v.pts>=t.pass; })
    .sort();
  if(!passDays.length) return [];
  const streaks = [];
  let current = [passDays[0]];
  for(let i = 1; i < passDays.length; i++) {
    const prev = new Date(passDays[i-1] + 'T12:00:00');
    const curr = new Date(passDays[i] + 'T12:00:00');
    const diff = Math.round((curr - prev) / (1000 * 60 * 60 * 24));
    if(diff === 1) { current.push(passDays[i]); }
    else { streaks.push([...current]); current = [passDays[i]]; }
  }
  streaks.push([...current]);
  return streaks.sort((a,b) => b.length - a.length);
}

function checkNewHighScore() {
  const todayStr = todayKey();
  if(!data[todayStr] || !data[todayStr].pts) return;
  const currentStreak = calcStreak();
  if(!currentStreak) return;
  const streaks = getHistoricalStreaks();
  const prevBest = streaks.length > 1 ? streaks[1].length
    : (streaks.length === 1 && streaks[0][streaks[0].length-1] !== todayStr ? streaks[0].length : 0);
  const alreadyToasted = localStorage.getItem('gol-hs-toast-' + todayStr);
  if(currentStreak > prevBest && !alreadyToasted) {
    localStorage.setItem('gol-hs-toast-' + todayStr, '1');
    setTimeout(() => {
      showToast('★ NEW STREAK RECORD! ' + currentStreak + ' days 🔥 ★');
      launchFireworks(30);
    }, 500);
  }
}

