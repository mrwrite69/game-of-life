// ─── SUBMIT ───────────────────────────────────────────────────────────────────
async function submitDay(){
  const tk=todayKey(),t=getThresholds();
  // ⚔️ Elite Task check — finishing with an unfinished elite task means the day is LOST
  const eliteTasks=(data[tk]&&data[tk].eliteTasks)||[];
  const missedElite=eliteTasks.filter(x=>!x.done);
  if(missedElite.length&&!confirm(`⚔️ ${missedElite.length===1?'An Elite Task is':missedElite.length+' Elite Tasks are'} NOT done!\n\nFinishing now means the day is LOST — 0 points, streak gone — no matter what else you scored.\n\nFinish anyway?`))return;
  const pts=calcTodayPts();
  const acts=Object.entries(todayChecked).filter(([name])=>!name.startsWith('mission_')).map(([name,count])=>({name,count}));
  const sqActs=((data[tk]&&data[tk].activities)||[]).filter(a=>a.sideQuest);
  const notes=document.getElementById('mood-notes').value;
  data[tk]={pts,activities:[...acts,...sqActs],locked:true,ts:Date.now(),mood:{...todayMood,notes},earlyBird:new Date().getHours()<8,hadCombo:hasCombo(),bossBattles:bossBattlesLogged[tk]||{},eliteTasks,eliteFailed:!!(data[tk]&&data[tk].eliteFailed)};
  if(missedElite.length){data[tk].eliteFailed=true;data[tk].failedPts=pts;data[tk].pts=0;}
  await saveToSupabase();
  if(data[tk].eliteFailed){
    showToast('💀 Elite Task failed — day lost. Tomorrow, redemption. 🐾',5000);
    document.getElementById('submit-btn').textContent='Day Lost 💀';
    document.getElementById('submit-note').textContent='Do or die. Tomorrow, redemption ⚔️';
    updatePointsUI();updateLevelUI();renderEliteTasks();
    return;
  }
  soundLockIn();
  const fireworks=pts>=t.excellent?80:pts>=t.pass?40:20;
  launchFireworks(fireworks);
  const msg=pts>=t.elite?'ELITE day! 👑 '+pts+' pts':pts>=t.excellent?'Excellent! '+pts+' pts 🔥':pts>=t.strong?'Strong day! '+pts+' pts ⚡':pts>=t.pass?'Day done! '+pts+' pts 🐾':'Day finished. '+pts+' pts';
  showToast(msg);
  document.getElementById('submit-btn').textContent='Day Finished! ✨';
  document.getElementById('submit-note').textContent=pts>=t.pass?'Streak intact 🔥':'Keep going — tomorrow is a new day 🐾';
  updatePointsUI();updateLevelUI();checkAchievements();updateMissionProgress();checkSmartMissions();
}

function resetDay(){
