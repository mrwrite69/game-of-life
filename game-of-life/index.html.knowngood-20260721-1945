// ─── SUPABASE LOAD/SAVE ───────────────────────────────────────────────────────
async function loadFromSupabase(){
  if(!currentUser)return;
  // Unsynced offline progress? Push it up FIRST — pulling now would overwrite it
  if(pendingCloudSync){
    console.log('[GOL] Pending offline changes — pushing instead of pulling');
    await saveToSupabase();
    return;
  }
  setSyncState('syncing');
  console.log('[GOL] loadFromSupabase — user:', currentUser.id);
  try{
    const{data:rows,error}=await sb.from('game_data').select('*').eq('user_id',currentUser.id).maybeSingle();
    if(error){console.error('[GOL] Load error:', error.message, error.code);throw error;}
    if(rows){
      console.log('[GOL] Row found. Keys:', Object.keys(rows), '| days count:', Object.keys(rows.days||{}).length);
      data=rows.days||{};
      categories=rows.categories&&rows.categories.length?rows.categories:[];
      challenges=(rows.challenges||[]).filter(c=>!c.expired);
      playerName=rows.player_name||playerName;
      difficulty=rows.difficulty||'normal';
      missions=rows.missions||[];
      if(rows.boss_battles) bossBattlesLogged={...bossBattlesLogged,...rows.boss_battles};
      if(rows.notif_settings) notifSettings={...notifSettings,...rows.notif_settings};
      // Retired notification types — force off even if old cloud data has them on
      notifSettings.morning=false;notifSettings.evening=false;notifSettings.streak=false;
      if(rows.rest_days && rows.rest_days.length) restDays=rows.rest_days;
      if(rows.timezone) localStorage.setItem('gol-timezone', rows.timezone);
      if(rows.side_quests && rows.side_quests.length) sideQuests=rows.side_quests;
      const saved=rows.achievements||[];
      achievements=DEFAULT_ACHIEVEMENTS.map(def=>{const s=saved.find(x=>x.id===def.id);return s?{...def,...s,check:def.check}:{...def};});
      saved.filter(s=>s.custom).forEach(s=>{if(!achievements.find(a=>a.id===s.id))achievements.push(s);});
      console.log('[GOL] Load complete ✅ categories:', categories.length, 'missions:', missions.length, 'sideQuests:', sideQuests.length);
    } else {
      console.log('[GOL] No row found — new player, showing game picker');
      categories=[];achievements=DEFAULT_ACHIEVEMENTS.map(d=>({...d}));missions=[];sideQuests=[];
    }
    challenges.forEach(c=>{if(c.endsAt&&!c.completed&&!c.failed)startChallengeCountdown(c);});
    setSyncState('synced');
    lastLoadedAt = Date.now();
    saveLocalCache(); // refresh the offline cache with what we just pulled
    // ⚔️ Retroactively fail any past day that ended with an unfinished Elite Task
    enforcePastEliteTasks();
    // Check streak milestones after data is fresh
    setTimeout(checkMilestoneNotification, 3000);
  }catch(e){
    console.error('[GOL] Load failed:', e);
    // 📴 Cloud unreachable — fall back to the last data saved on this device
    if(loadLocalCache()){
      setSyncState('error');
      lastLoadedAt=Date.now(); // don't hammer retries on every foreground
      challenges.forEach(c=>{if(c.endsAt&&!c.completed&&!c.failed)startChallengeCountdown(c);});
      enforcePastEliteTasks();
      showToast('📴 Offline — using data saved on this device');
    } else {
      setSyncState('error');
    }
  }
}

// ─── OFFLINE CACHE ───────────────────────────────────────────────────────────
// Every save mirrors the full game state to localStorage. If the cloud is
// unreachable (no wifi/data), the app boots and runs from this cache, and a
// pending-sync flag pushes everything back up the moment we're online again.
const OFFLINE_CACHE_KEY='gol-offline-cache';
let pendingCloudSync=localStorage.getItem('gol-pending-sync')==='1';
function setPendingSync(v){pendingCloudSync=v;try{v?localStorage.setItem('gol-pending-sync','1'):localStorage.removeItem('gol-pending-sync');}catch(e){}}

function saveLocalCache(){
  try{
    const achToSave=achievements.map(({check,...rest})=>rest);
    localStorage.setItem(OFFLINE_CACHE_KEY,JSON.stringify({
      userId:currentUser?currentUser.id:'',userEmail:currentUser?(currentUser.email||''):'',
      playerName,days:data,categories,challenges,achievements:achToSave,difficulty,missions,
      bossBattles:bossBattlesLogged,notifSettings,restDays,sideQuests,
      savedAt:new Date().toISOString()
    }));
  }catch(e){console.warn('[GOL] Offline cache write failed:',e);}
}

function loadLocalCache(){
  try{
    const raw=localStorage.getItem(OFFLINE_CACHE_KEY);
    if(!raw)return false;
    const c=JSON.parse(raw);
    data=c.days||{};
    categories=c.categories||[];
    challenges=(c.challenges||[]).filter(ch=>!ch.expired);
    playerName=c.playerName||playerName;
    difficulty=c.difficulty||'normal';
    missions=c.missions||[];
    bossBattlesLogged=c.bossBattles||{};
    restDays=c.restDays||[];
    sideQuests=c.sideQuests||[];
    if(c.notifSettings)notifSettings={...notifSettings,...c.notifSettings};
    notifSettings.morning=false;notifSettings.evening=false;notifSettings.streak=false;
    const saved=c.achievements||[];
    achievements=DEFAULT_ACHIEVEMENTS.map(def=>{const s=saved.find(x=>x.id===def.id);return s?{...def,...s,check:def.check}:{...def};});
    saved.filter(s=>s.custom).forEach(s=>{if(!achievements.find(a=>a.id===s.id))achievements.push(s);});
    console.log('[GOL] Loaded from offline cache 📴 (last synced '+(c.savedAt||'unknown')+')');
    return true;
  }catch(e){console.warn('[GOL] Offline cache read failed:',e);return false;}
}

async function saveToSupabase(){
  if(!currentUser)return;
  saveLocalCache(); // device always keeps the freshest copy, online or not
  setSyncState('syncing');
  console.log('[GOL] saveToSupabase — days:', Object.keys(data).length, '| categories:', categories.length, '| sideQuests:', sideQuests.length);
  try{
    const achToSave=achievements.map(({check,...rest})=>rest);
    const tz=localStorage.getItem('gol-timezone')||'';
    const payload={user_id:currentUser.id,days:data,boss_battles:bossBattlesLogged,categories,challenges,achievements:achToSave,player_name:playerName,difficulty,missions,notif_settings:notifSettings,rest_days:restDays,timezone:tz,side_quests:sideQuests,updated_at:new Date().toISOString()};
    const{error}=await sb.from('game_data').upsert(payload,{onConflict:'user_id'});
    if(error){console.error('[GOL] Save error:', error.message, error.code, error.details);throw error;}
    console.log('[GOL] Save complete ✅');
    if(pendingCloudSync){setPendingSync(false);showToast('☁️ Back online — offline progress synced!');}
    setSyncState('synced');
  }catch(e){
    setSyncState('error');
    if(!pendingCloudSync){setPendingSync(true);showToast('📴 Offline — progress saved on this device. Will sync when you\'re back.');}
    console.error('[GOL] Save failed (kept locally):', e);
  }
}

// The moment connectivity returns, push any offline progress up
window.addEventListener('online',async()=>{
  if(currentUser&&pendingCloudSync){
    console.log('[GOL] Connection restored — pushing offline changes ☁️');
    await saveToSupabase();
  }
});

async function manualRefresh(){
  if(!confirm('Pull latest data from cloud?\n\nThis will replace your current local state with the cloud version. Any unsynced local changes will be lost.\n\nTip: hit Sync first if you want to save what you have!')) return;
  const btn=document.getElementById('refresh-btn');
  if(btn){btn.textContent='⏳';btn.disabled=true;}
  await loadFromSupabase();
  // Re-apply today's checked state from freshly loaded data
  const tk=todayKey();
  todayChecked={};
  if(data[tk]&&data[tk].activities){
    data[tk].activities.forEach(a=>{if(!a.sideQuest)todayChecked[a.name]=a.count||1;});
    if(data[tk].locked){
      document.getElementById('submit-btn').textContent='Day Locked!';
      document.getElementById('submit-note').textContent=data[tk].pts>=getThresholds().pass?'Pass — streak intact! 🔥':'Under threshold — streak reset';
    }
    if(data[tk].mood){
      todayMood=data[tk].mood;
      ['energy','mood'].forEach(type=>{const val=todayMood[type];if(val)document.querySelector(`.mood-emoji[data-type="${type}"][data-val="${val}"]`)?.classList.add('selected');});
      if(todayMood.notes)document.getElementById('mood-notes').value=todayMood.notes;
    }
    bossBattlesLogged[tk]=data[tk].bossBattles||{large:[],medium:[],small:[]};
  }
  renderActivities();renderBossBattles();updatePointsUI();updateLevelUI();renderChallenges();
  if(btn){btn.textContent='🔃 Refresh';btn.disabled=false;}
  showToast('Refreshed from cloud! 🔃');
}

function debouncedSave(){clearTimeout(syncTimeout);syncTimeout=setTimeout(saveToSupabase,1500);}
function getActs(){return categories.flatMap(c=>c.activities);}
function stepNum(id,delta,min=1,max=9999){const inp=document.getElementById(id);const disp=document.getElementById(id+'-display');let val=Math.max(min,Math.min(max,(parseInt(inp.value)||0)+delta));inp.value=val;if(disp)disp.textContent=val;}
// Point steppers move ±5 — unless Hard or Elite mode (±1, no easy inflation). Time/day steppers stay ±1 via stepNum.
function ptsStep(){return (difficulty==='hard'||difficulty==='elite')?1:5;}
function stepPts(id,dir,min=1,max=9999){stepNum(id,dir*ptsStep(),min,max);}

// ─── ELITE TASKS — DO OR DIE ─────────────────────────────────────────────────
// Stored in data[dateKey].eliteTasks = [{id,name,pts,done}]. If any task is not
// done when the day truly ends (midnight, night owl end, or manual lock-in),
// the day is LOST: pts → 0 (streak breaks automatically via calcStreak).
// Max 1 per day — unless Elite difficulty (unlimited).

function renderEliteTasks(){
  const list=document.getElementById('elite-tasks-list');
  if(!list)return;
  const sub=document.getElementById('elite-tasks-sub');
  if(sub)sub.textContent=difficulty==='elite'?'Do or die · unlimited — as many as you dare':'Do or die · 1 per day';
  const tk=todayKey();
  const tasks=(data[tk]&&data[tk].eliteTasks)||[];
  const failed=data[tk]&&data[tk].eliteFailed;
  list.innerHTML=tasks.map(t=>`
    <div class="elite-task-card ${t.done?'done':''}" onclick="completeEliteTask(${t.id})">
      <span class="elite-task-name">${t.done?'✅':'⚔️'} ${t.name}</span>
      <span class="elite-task-pts">${t.done?'CONQUERED · +'+t.pts+'pts':'+'+t.pts+'pts · DO OR DIE'}</span>
    </div>`).join('')
    +(failed?'<div class="elite-failed-banner">💀 Elite Task missed — day lost. Tomorrow, redemption. 🐾</div>':'');
}

function openEliteTaskForm(){
  const tk=todayKey();
  if(data[tk]&&data[tk].locked){showToast('Day already finished — Elite Tasks arm tomorrow ⚔️');return;}
  if(data[tk]&&data[tk].eliteFailed){showToast('💀 Today is already lost. Tomorrow, redemption.');return;}
  const count=((data[tk]&&data[tk].eliteTasks)||[]).length;
  if(difficulty!=='elite'&&count>=1){showToast('⚔️ One Elite Task per day — unless you dare go Elite mode.');return;}
  document.getElementById('et-name').value='';
  document.getElementById('et-pts').value='50';
  document.getElementById('et-pts-display').textContent='50';
  document.getElementById('elite-confirm-overlay').classList.add('visible');
  setTimeout(()=>document.getElementById('et-name').focus(),100);
}

function closeEliteTaskForm(){
  document.getElementById('elite-confirm-overlay').classList.remove('visible');
}

function confirmEliteTask(){
  const name=document.getElementById('et-name').value.trim();
  const pts=parseInt(document.getElementById('et-pts').value)||50;
  if(!name){showToast('Name your Elite Task first ⚔️');return;}
  const tk=todayKey();
  if(!data[tk])data[tk]={pts:0,activities:[],locked:false};
  if(!data[tk].eliteTasks)data[tk].eliteTasks=[];
  data[tk].eliteTasks.push({id:Date.now(),name,pts,done:false});
  closeEliteTaskForm();
  debouncedSave();
  renderEliteTasks();
  showToast('⚔️ Elite Task armed. Do or die.');
