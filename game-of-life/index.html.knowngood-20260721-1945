  const allMissions=[...DEFAULT_MISSIONS,...missions.filter(m=>m.custom)];

  // Always show active missions first at the top
  const activeDefs = allMissions.filter(m=>{const s=missions.find(x=>x.id===m.id);return s&&s.active;});
  const completedDefs = allMissions.filter(m=>{const s=missions.find(x=>x.id===m.id);return s&&s.completed;});
  const availableDefs = allMissions.filter(m=>{const s=missions.find(x=>x.id===m.id);return !s||(!s.active&&!s.completed);});

  let filtered;
  if(missionsFilter==='active') filtered=activeDefs;
  else if(missionsFilter==='all') filtered=[...activeDefs,...availableDefs,...completedDefs];
