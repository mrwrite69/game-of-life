const DIFF_MULTIPLIERS={easy:1.3,normal:1.0,hard:0.7,elite:0.7};
const BASE_THRESHOLDS={pass:200,strong:280,excellent:350,elite:500};
let difficulty='normal';

function getThresholds(){
  const m=DIFF_MULTIPLIERS[difficulty];
  if(difficulty==='easy') return {pass:150,strong:200,excellent:280,elite:380};
  if(difficulty==='hard'||difficulty==='elite') return {pass:200,strong:280,excellent:350,elite:500};
  return BASE_THRESHOLDS;
}
function applyDiff(pts){return Math.round(pts*DIFF_MULTIPLIERS[difficulty]);}
function getBossPoints(){return {large:applyDiff(120),medium:applyDiff(60),small:applyDiff(25)};}

function setDifficulty(mode,btn){
  difficulty=mode;
  document.querySelectorAll('.diff-btn').forEach(b=>b.classList.remove('active'));
