async function saveCalEdit(){
  if(!calEditKey)return;
  let pts=0;
  calEditActivities.forEach(a=>{const act=getActs().find(x=>x.name===a.name);if(act)pts+=applyDiff(act.pts)*(a.count||1);else if(a.sideQuest&&a.pts)pts+=a.pts;});
  // Add boss battle points — use getBossPoints() so difficulty is respected
  const bossPts=getBossPoints();
  Object.entries(calEditBossBattles).forEach(([tier,names])=>{pts+=names.length*(bossPts[tier]||0);});
  // Save boss battles to the log
  bossBattlesLogged[calEditKey]=calEditBossBattles;
  const editedNames=calEditActivities.map(a=>a.name);
  const editHadCombo=categories.some(c=>COMBO_BODY.includes(c.name)&&c.activities.some(a=>editedNames.includes(a.name)))
    &&categories.some(c=>COMBO_MIND.includes(c.name)&&c.activities.some(a=>editedNames.includes(a.name)))
    &&categories.some(c=>COMBO_SOUL.includes(c.name)&&c.activities.some(a=>editedNames.includes(a.name)));
  // Apply combo multiplier — was missing, causing score to drop on edit when day had Body+Mind+Soul
  if(editHadCombo) pts=Math.round(pts*1.15);
  data[calEditKey]={...(data[calEditKey]||{}),activities:calEditActivities,pts,locked:true,bossBattles:calEditBossBattles,hadCombo:editHadCombo};
  // ⚔️ A day lost to an Elite Task stays lost — calendar edits can't resurrect it
  if(data[calEditKey].eliteFailed)data[calEditKey].pts=0;
  await saveToSupabase();
  document.getElementById('cal-edit-panel').classList.remove('visible');
  document.getElementById('day-detail').classList.remove('visible');
  renderCalendar();showToast('Day updated! ✏️');
  checkAchievements();updateMissionProgress();
}

