    <button class="quick-pts-dismiss" onclick="closeQuickPtsPopup()">Cancel</button>
  `;

  window.qpToggleMulti = () => {
    multiState = !multiState;
    const btn = document.getElementById('qp-multi-btn');
    if(btn) {
      btn.style.borderColor = multiState ? 'var(--gold)' : 'var(--border)';
      btn.style.background = multiState ? 'rgba(200,168,75,0.12)' : 'var(--surface)';
      btn.style.color = multiState ? 'var(--gold)' : 'var(--muted)';
      btn.textContent = multiState ? '✓ Multi-click ON — tap to disable' : 'Multi-click OFF — tap to enable';
    }
  };

  window.qpSave = (ci, ai) => {
    const newName = document.getElementById('qp-name').value.trim();
    const newPts = parseInt(document.getElementById('qp-pts').value) || actPts;
    if(!newName) { showToast('Give it a name!'); return; }
    if(categories[ci] && categories[ci].activities[ai]) {
      categories[ci].activities[ai].name = newName;
      categories[ci].activities[ai].pts = newPts;
      categories[ci].activities[ai].multi = multiState;
      debouncedSave();
      renderActivities();
      showToast(newName + ' → ' + newPts + ' pts' + (multiState ? ' · multi ✓' : '') + ' ⚡');
    }
    closeQuickPtsPopup();
  };

  // Position near touch/click
  const rect = e.target.closest('.act-btn').getBoundingClientRect();
  const top = Math.min(rect.bottom + 8, window.innerHeight - 240);
  const left = Math.max(8, Math.min(rect.left, window.innerWidth - 230));
  popup.style.top = top + 'px';
  popup.style.left = left + 'px';

  document.body.appendChild(popup);
  quickPtsPopup = popup;
  setTimeout(() => document.getElementById('qp-pts').focus(), 50);

  // Close on outside click
  setTimeout(() => {
    document.addEventListener('click', closeQuickPtsPopupOutside);
  }, 100);
}

function closeQuickPtsPopupOutside(e) {
  const popup = document.getElementById('quick-pts-popup');
  if(popup && !popup.contains(e.target)) closeQuickPtsPopup();
}

function closeQuickPtsPopup() {
  const popup = document.getElementById('quick-pts-popup');
  if(popup) popup.remove();
  document.removeEventListener('click', closeQuickPtsPopupOutside);
  quickPtsPopup = null;
}

function setupLongPress(btn, ci, ai, actName, actPts, actMulti) {
  // Touch devices
  btn.addEventListener('touchstart', (e) => {
    longPressTimer = setTimeout(() => {
      openQuickPtsEditor(e.touches[0], ci, ai, actName, actPts, actMulti);
    }, LONG_PRESS_MS);
  }, { passive: true });
  btn.addEventListener('touchend', () => clearTimeout(longPressTimer));
  btn.addEventListener('touchmove', () => clearTimeout(longPressTimer));
  // Desktop: right-click
  btn.addEventListener('contextmenu', (e) => {
    e.preventDefault();
    openQuickPtsEditor(e, ci, ai, actName, actPts, actMulti);
  });
}

// ─── UNDO LAST ACTIVITY ───────────────────────────────────────────────────────
let lastActivityLog = null; // {name, pts, multi, wasChecked, count}

function undoLastActivity() {
  if(!lastActivityLog) { showToast('Nothing to undo! 🤷'); return; }
  const {name, multi, prevCount} = lastActivityLog;
  if(prevCount === 0) {
    delete todayChecked[name];
  } else {
    todayChecked[name] = prevCount;
  }
  // Also reverse any mission auto-mark that was set when this activity was logged
  missions.filter(m => m.active && !m.completed && m.linkedActivities && m.linkedActivities.length > 0).forEach(m => {
    if(!m.linkedActivities.some(la => la.name === name)) return;
    const anyStillChecked = m.linkedActivities.some(la => (todayChecked[la.name] || 0) > 0);
    if(!anyStillChecked) { delete todayChecked['mission_'+m.id]; delete m.lastLoggedDay; }
  });
  autosave();
  updatePointsUI();
  renderActivities();
  showToast('↩ Undone: ' + name);
  soundTap();
  lastActivityLog = null;
  const btn = document.getElementById('undo-btn');
  if(btn) btn.disabled = true;
}

function toggleAct(name,pts,multi,btn){
  soundTap();btn.classList.add('pop');setTimeout(()=>btn.classList.remove('pop'),250);
  // Store for undo
  lastActivityLog = {name, pts, multi, prevCount: todayChecked[name]||0};
  const undoBtn = document.getElementById('undo-btn');
  if(undoBtn) undoBtn.disabled = false;
  const wasUnchecked = !todayChecked[name];
  if(multi){todayChecked[name]=(todayChecked[name]||0)+1;}else{if(todayChecked[name])delete todayChecked[name];else todayChecked[name]=1;}
  if(wasUnchecked && todayChecked[name]) { trackActivityLog(true); checkEarlyBird(); }
  // Surgical button update — no full re-render!
  const c=todayChecked[name]||0;
  btn.classList.toggle('checked', c>0);
  // Update count badge
  let countBadge=btn.querySelector('.act-count');
  if(multi&&c>1){if(!countBadge){countBadge=document.createElement('span');countBadge.className='act-count';btn.appendChild(countBadge);}countBadge.textContent='x'+c;}
  else if(countBadge){countBadge.remove();}
  // Auto-mark any mission whose linked activities include this one
  missions.filter(m => m.active && !m.completed && m.linkedActivities && m.linkedActivities.length > 0).forEach(m => {
    const isLinked = m.linkedActivities.some(la => la.name === name);
    if (!isLinked) return;
    const todayStr = todayKey();
    if ((todayChecked[name] || 0) > 0) {
      // Activity just got checked — mark mission logged for today
      todayChecked['mission_'+m.id] = 1;
      m.lastLoggedDay = todayStr;
    } else {
      // Activity unchecked — only clear if NO other linked activity is still checked
      const anyStillChecked = m.linkedActivities.some(la => (todayChecked[la.name] || 0) > 0);
      if (!anyStillChecked) { delete todayChecked['mission_'+m.id]; delete m.lastLoggedDay; }
    }
  });
  autosave();
  updatePointsUI();
  refreshMissionOnTrack();
  showToast(c>0?`+${applyDiff(pts)} pts${c>1?' (x'+c+')':''}`:'−'+applyDiff(pts)+' pts');
  // Debounce heavy checks — don't run on every tap
  clearTimeout(window._achieveTimer);
  window._achieveTimer=setTimeout(()=>{checkAchievements();updateLevelUI();updateMissionProgress();checkRestDayEarning();checkNewHighScore();},800);
}

function autosave(){
  const tk=todayKey(),acts=Object.entries(todayChecked).filter(([n])=>!n.startsWith('mission_')).map(([n,c])=>({name:n,count:c}));
  const sqActs=((data[tk]&&data[tk].activities)||[]).filter(a=>a.sideQuest);
  data[tk]={...(data[tk]||{}),pts:calcTodayPts(),activities:[...acts,...sqActs],locked:!!(data[tk]&&data[tk].locked),earlyBird:new Date().getHours()<8,hadCombo:hasCombo(),bossBattles:bossBattlesLogged[tk]||{}};
  debouncedSave();
  // Rest day earning checked on lock-in only (see lockDay)
}

function toggleEditMode(){editMode=!editMode;const btn=document.getElementById('edit-mode-btn');btn.textContent=editMode?'✅ Done':'✏️ Edit';btn.classList.toggle('active',editMode);renderActivities();showToast(editMode?'Edit mode — tap any card':'Changes saved!');}
function saveAct(ci,ai){const name=document.getElementById(`en-${ci}-${ai}`).value.trim();const pts=parseInt(document.getElementById(`ep-${ci}-${ai}`).value)||0;const multi=document.getElementById(`em-${ci}-${ai}`).checked;if(!name)return;const old=categories[ci].activities[ai].name;if(todayChecked[old]){todayChecked[name]=todayChecked[old];delete todayChecked[old];}categories[ci].activities[ai]={name,pts,multi};debouncedSave();renderActivities();showToast('Saved!');}
function delAct(ci,ai){const name=categories[ci].activities[ai].name;if(todayChecked[name])delete todayChecked[name];categories[ci].activities.splice(ai,1);debouncedSave();renderActivities();showToast('Removed');}
