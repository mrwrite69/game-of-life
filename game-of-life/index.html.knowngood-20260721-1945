// ─── POINTS ───────────────────────────────────────────────────────────────────
function calcRawPts(){
  let pts=0;
  Object.entries(todayChecked).forEach(([name,count])=>{const a=getActs().find(x=>x.name===name);if(a)pts+=applyDiff(a.pts)*count;});
  challenges.forEach(c=>{if(c.completed&&c.completedToday&&c.type==='bonus')pts+=c.pts;if(c.failed&&c.failedToday&&c.type==='penalty')pts-=c.pts;});
  const bp=getBossPoints();const tb=todayBosses();
  pts+=tb.large*bp.large+tb.medium*bp.medium+tb.small*bp.small;
  // Side quest completions (custom pts not in getActs)
  const sqActs=(data[todayKey()]&&data[todayKey()].activities)||[];
  sqActs.forEach(a=>{if(a.sideQuest&&a.pts)pts+=a.pts;});
  return Math.max(0,pts);
}
function calcTodayPts(){const td=data[todayKey()];if(td&&td.eliteFailed)return 0;const raw=calcRawPts();return hasCombo()?Math.round(raw*1.15):raw;}
function todayBosses(){const tb=bossBattlesLogged[todayKey()]||{};return {large:Array.isArray(tb.large)?tb.large.length:0,medium:Array.isArray(tb.medium)?tb.medium.length:0,small:Array.isArray(tb.small)?tb.small.length:0};}
function calcStreak(){let streak=0,d=new Date();const t=getThresholds();for(let i=0;i<200;i++){const k=dateKey(d);if(data[k]&&(data[k].pts>=t.pass||data[k].restDay)){streak++;d.setDate(d.getDate()-1);}else break;}return streak;}

