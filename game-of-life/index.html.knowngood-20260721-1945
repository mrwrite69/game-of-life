  renderActivities();
  updatePointsUI();renderBossBattles();updateProgressMarkers();
  renderEliteTasks();
  showToast(mode==='easy'?'🌱 Easy Mode — points ×1.3!'
    :mode==='hard'?'🔥 Hard Mode — points ×0.7. No mercy!'
    :mode==='elite'?'⚔️ ELITE — do or die. Unlimited Elite Tasks. Miss one and the day is LOST.'
    :'⚖️ Normal Mode');
  debouncedSave();
}

function updateProgressMarkers(){
