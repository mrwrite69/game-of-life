    // Check for days needing check-off prompt
    let promptDay = null;
    for(let i = 0; i < Math.min(daysToShow, 7); i++) {
      const d = new Date(day1); d.setDate(day1.getDate() + i);
      if(d >= today) break;
      const k = dateKey(d);
      const dd = data[k];
      const hasScore = dd && (dd.pts > 0 || dd.restDay);
      if(hasScore && !isDayChecked(k)) { promptDay = {d, k, dayNum: i+1}; break; }
    }
    if(promptDay) {
