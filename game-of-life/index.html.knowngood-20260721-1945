// ─── INIT ─────────────────────────────────────────────────────────────────────
async function init(){
  // Fast-path: if no local Supabase session token exists, skip the network call
  // and show the auth screen immediately — no waiting on Supabase.
  const hasLocalSession = Object.keys(localStorage).some(k => k.startsWith('sb-') && k.endsWith('-auth-token'));
  if(!hasLocalSession){
    hideLoadingScreen();
    document.getElementById('auth-screen').style.display='flex';
    return;
  }
  // 📴 Boot from the offline cache when the cloud can't be reached
  function bootOfflineFromCache(){
    if(!loadLocalCache())return false;
    let cachedId='',cachedEmail='';
    try{const c=JSON.parse(localStorage.getItem(OFFLINE_CACHE_KEY)||'{}');cachedId=c.userId||'';cachedEmail=c.userEmail||'';}catch(e){}
    if(!cachedId||!categories||!categories.length)return false;
    currentUser={id:cachedId,email:cachedEmail};
    setSyncState('error');
    challenges.forEach(c=>{if(c.endsAt&&!c.completed&&!c.failed)startChallengeCountdown(c);});
    enforcePastEliteTasks();
    showApp();
    showToast('📴 Offline mode — everything saves on this device and syncs when you\'re back');
    return true;
  }
  try{
    const{data:{session}}=await sb.auth.getSession();
    if(session){
      currentUser=session.user;
      playerName=currentUser.user_metadata?.player_name||currentUser.email.split('@')[0];
      await loadFromSupabase();
      if(!categories||!categories.length){
        hideLoadingScreen();
        document.getElementById('game-picker').classList.add('show');
      } else {
        showApp();
      }
    } else if(bootOfflineFromCache()){
      // session refresh failed (likely offline) but we have cached data — keep playing
    } else {
      hideLoadingScreen();
      document.getElementById('auth-screen').style.display='flex';
    }
  }catch(e){
    console.warn('[GOL] init: cloud unreachable, trying offline cache…',e);
    if(!bootOfflineFromCache()){
      hideLoadingScreen();
      document.getElementById('auth-screen').style.display='flex';
    }
  }
}

