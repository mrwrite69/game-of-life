function launchFireworks(count=60){
  for(let i=0;i<count;i++){
    const x=Math.random()*canvas.width,y=Math.random()*canvas.height*0.6;
    const colors=['#c8a84b','#ff9933','#44cc88','#44aaff','#ff6688','#cc88ff','#ffffff'];
