      'Final check 🐾 Locked? Sleep well. Not yet? Night Owl has your back 🦉',
      'Rest is part of the game. Monty knew that. Lock in and goodnight 🌙👑',
    ];
    notifs.push({ id: 1005, title: '🌙 11:11',
      body: goodnightMsgs[Math.floor(Math.random()*goodnightMsgs.length)],
      largeIcon: 'ic_launcher', smallIcon: 'ic_stat_notify',
      schedule: { at: nextFireTime(23, 11), repeats: true, every: 'day' } });
  }
  if(notifs.length > 0) {
