function deleteBoss(tier,name){
  const tk=todayKey();
  if(!bossBattlesLogged[tk]||!bossBattlesLogged[tk][tier])return;
  bossBattlesLogged[tk][tier]=bossBattlesLogged[tk][tier].filter(n=>n!==name);
  autosave();renderBossBattles();updatePointsUI();
  showToast('Boss battle removed: '+name);
}

function logBoss(tier,name){
  const tk=todayKey();
  if(!bossBattlesLogged[tk])bossBattlesLogged[tk]={large:[],medium:[],small:[]};
  if(!bossBattlesLogged[tk][tier])bossBattlesLogged[tk][tier]=[];
  if(bossBattlesLogged[tk][tier].includes(name))return;
  bossBattlesLogged[tk][tier].push(name);
  const bp=getBossPoints();
  soundPass();showToast(`⚔️ Boss Battle complete! +${bp[tier]} pts`);
  launchFireworks(tier==='large'?60:tier==='medium'?30:15);
  autosave();renderBossBattles();updatePointsUI();checkAchievements();
}

function addCustomBoss(tier){
  const name=prompt(`Name your custom ${tier} Boss Battle:`);
  if(!name||!name.trim())return;
  const tk=todayKey();
  if(!bossBattlesLogged[tk])bossBattlesLogged[tk]={large:[],medium:[],small:[]};
  const key=`custom_${tier}`;
  if(!bossBattlesLogged[tk][key])bossBattlesLogged[tk][key]=[];
  bossBattlesLogged[tk][key].push(name.trim());
  renderBossBattles();showToast('Custom Boss Battle added!');
}

