try{const ctx=getCtx();[0,0.25,0.5].forEach(t=>{const o=ctx.createOscillator(),g=ctx.createGain();o.connect(g);g.connect(ctx.destination);o.frequency.value=880;g.gain.setValueAtTime(0.4,ctx.currentTime+t);g.gain.exponentialRampToValueAtTime(0.001,ctx.currentTime+t+0.2);o.start(ctx.currentTime+t);o.stop(ctx.currentTime+t+0.2);});}catch(e){soundPass();}}
function toggleTimer(){if(timerRunning){clearInterval(timerInterval);timerRunning=false;timerEndTime=null;}else{if(timerRemaining<=0)timerRemaining=timerTotal;timerEndTime=Date.now()+timerRemaining*1000;timerRunning=true;timerInterval=setInterval(()=>{if(timerEndTime){timerRemaining=Math.max(0,Math.round((timerEndTime-Date.now())/1000));}else{timerRemaining--;}renderTimer();if(timerRemaining<=0){timerDone();}},500);}renderTimer();}
