let missedDayPending = false;
let missedDayKey = null;

function getWeeklyStrikes() {
  // Count missed day acknowledgements this week (Mon-Sun window)
  let strikes = 0;
  for(let i = 1; i <= 7; i++) {
    const d = new Date(); d.setDate(d.getDate()-i);
    const k = dateKey(d);
    const val = localStorage.getItem('gol-sisyphus-'+k);
    if(val === 'yes' || val === 'auto-reset') strikes++;
  }
  return strikes;
}

// ─── START AGAIN ──────────────────────────────────────────────────────────────
let startAgainMode = false;

function confirmStartAgain() {
  startAgainMode = true;
  // Reuse Sisyphus overlay with start again messaging
  const t = getThresholds();
  const totalPts = Object.values(data).reduce((s,d)=>s+(d.pts||0),0);
  const passdays = Object.values(data).filter(d=>d&&d.pts>=t.pass).length;
  const bestDay = Math.max(0,...Object.values(data).map(d=>d&&d.pts||0));
  const streak = calcStreak();

  const el = document.getElementById('sisyphus-past-score');
  if(el) el.innerHTML = `
    <div style="font-family:var(--font-mono);font-size:11px;color:#7ec8e3;margin-bottom:8px;font-weight:700">Reset progress calendar to Day 1</div>
    <strong style="color:var(--text)">Your journey stays safe:</strong><br>
    ${streak} day streak · ${passdays} pass days · ${totalPts.toLocaleString()} total pts<br>
    Best day: ${bestDay} pts<br>
    All scores, badges and history are kept ✅<br><br>
    <strong style="color:var(--gold)">Let's beat Past ${playerName||'You'} from Day 1! 🐾</strong>
  `;

  // Change button text for start again mode
  const yesBtn = document.querySelector('#sisyphus-overlay .rest-day-overlay-btn');
  const noBtn = document.querySelector('#sisyphus-overlay .rest-day-overlay-dismiss');
  if(yesBtn) { yesBtn.textContent = 'Yes — Start Again from Day 1 🪨'; yesBtn.onclick = executeStartAgain; }
  if(noBtn) { noBtn.style.display = 'block'; noBtn.textContent = 'Cancel'; noBtn.onclick = cancelStartAgain; }

  document.getElementById('sisyphus-overlay').classList.add('visible');
}

