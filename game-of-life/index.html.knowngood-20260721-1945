// Compute streak from a friend's days object (same logic as calcStreak but on external data)
function calcFriendStreak(days, difficulty) {
  const t = (() => {
    if(difficulty === 'easy')   return {pass:100,strong:200,excellent:280,elite:350};
    if(difficulty === 'hard')   return {pass:300,strong:420,excellent:525,elite:750};
    return {pass:200,strong:280,excellent:350,elite:500};
  })();
  let streak = 0, d = new Date();
  for(let i = 0; i < 200; i++) {
    const k = dateKey(d);
    if(days[k] && (days[k].pts >= t.pass || days[k].restDay)) { streak++; d.setDate(d.getDate()-1); }
    else break;
  }
  return streak;
}

// Compute pts for a given period from friend's days object
function calcFriendPeriodPts(days, period) {
  const today = new Date();
  let pts = 0;
  if(period === 'today') {
    const k = dateKey(today);
    return (days[k] && days[k].pts) ? days[k].pts : 0;
  }
  const days_count = period === 'week' ? 7 : 30;
  for(let i = 0; i < days_count; i++) {
    const d = new Date(today); d.setDate(today.getDate() - i);
    const k = dateKey(d);
    if(days[k] && days[k].pts) pts += days[k].pts;
  }
  return pts;
}

// Get level info from pass day count (friend version — no custom level 12)
function getFriendLevel(days, difficulty) {
  const t = (() => {
    if(difficulty === 'easy')   return {pass:100};
    if(difficulty === 'hard')   return {pass:300};
    return {pass:200};
  })();
  const passCount = Object.values(days).filter(v => v && (v.restDay || v.pts >= t.pass)).length;
  let lv = LEVELS[0];
  for(const l of LEVELS) { if(passCount >= l.days) lv = l; else break; }
  return lv;
}

async function loadFriends() {
  if(!currentUser) return;
  const listEl = document.getElementById('friends-list');
  const reqEl  = document.getElementById('friends-requests-list');
  if(listEl) listEl.innerHTML = '<div class="friends-empty">Loading…</div>';

  try {
    // 1. Get accepted friend IDs (both directions)
    const [{ data: sentRows }, { data: recvRows }] = await Promise.all([
      sb.from('friends').select('friend_user_id, status').eq('user_id', currentUser.id),
      sb.from('friends').select('user_id, status').eq('friend_user_id', currentUser.id),
    ]);

    const accepted = new Set();
    const pendingIncoming = []; // { user_id }

    (sentRows || []).forEach(r => { if(r.status === 'accepted') accepted.add(r.friend_user_id); });
    (recvRows || []).forEach(r => {
      if(r.status === 'accepted') accepted.add(r.user_id);
      if(r.status === 'pending') pendingIncoming.push(r.user_id);
    });

    // Update badge
    const badge = document.getElementById('fr-badge');
    if(badge) { badge.textContent = pendingIncoming.length; badge.style.display = pendingIncoming.length ? 'inline' : 'none'; }

    // 2. Render pending requests
    await renderFriendRequests(pendingIncoming, reqEl);

    // 3. Pull game_data for accepted friends
    if(accepted.size === 0) {
      friendsCache = [];
      renderFriendsLeaderboard([]);
      return;
    }
    const { data: friendData, error } = await sb
      .from('game_data')
      .select('user_id, player_name, days, difficulty')
      .in('user_id', [...accepted]);

    if(error) throw error;
    friendsCache = friendData || [];
    renderFriendsLeaderboard(friendsCache);
  } catch(e) {
    console.error('loadFriends error', e);
    if(listEl) listEl.innerHTML = `<div class="friends-empty">Could not load friends. Check Supabase RLS.</div>`;
  }
}

function renderFriendsLeaderboard(rows) {
