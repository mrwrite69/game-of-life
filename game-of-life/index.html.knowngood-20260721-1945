}

function closeArmSideQuest(){
  sqEliteArmId=null;
  document.getElementById('sqe-confirm-overlay').classList.remove('visible');
}

function confirmArmSideQuest(){
  const q=sideQuests.find(x=>x.id===sqEliteArmId);
  document.getElementById('sqe-confirm-overlay').classList.remove('visible');
  sqEliteArmId=null;
  if(!q)return;
  q.elite=true;q.armedFor=todayKey();
  getSideGame(); // make sure the scoreboard exists from the first arm
  debouncedSave();renderSideQuests();
  showToast('⚔️ Armed! Due by end of day — or the Side Game resets to zero.');
  soundTap();
}

// Called when a day truly ends (midnight, night owl end). Returns true if the side game was just lost.
function enforceEliteSideQuests(k){
  const missed=sideQuests.filter(q=>q.elite&&q.armedFor&&q.armedFor<=k);
  if(!missed.length)return false;
  const sg=getSideGame();
  const lost=sg.score;
  sg.score=0;sg.losses+=missed.length;
  missed.forEach(q=>{q.elite=false;q.armedFor='';});
  console.log('[GOL] ⚔️ Side Game reset — '+lost+' pts lost, '+missed.length+' quest(s) missed');
  return true;
}
// ─── NIGHT OWL MODE ──────────────────────────────────────────────────────────
let nightOwlActive = false;
let nightOwlDateKey = ''; // the date the player is "still on"
let nightOwlExpireTimer = null;
let nightOwlBannerTimer = null;
let nightOwlScheduled = false; // pre-midnight: player activated early, fires at midnight
let nightOwlScheduleTimer = null;

function todayKey() {
  if(nightOwlActive && nightOwlDateKey) return nightOwlDateKey;
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}
function dateKey(d){return`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;}

function activateNightOwl() {
  const now = new Date();
  const isAfterMidnight = now.getHours() < 3; // 12:00 AM – 2:22 AM
  if(!isAfterMidnight) {
    // Before midnight — schedule activation for midnight so the day doesn't roll over
    if(nightOwlScheduled) { showToast('🦉 Night Owl already set — activates at midnight!'); return; }
    nightOwlScheduled = true;
    const midnight = new Date(); midnight.setHours(24, 0, 5, 0); // next midnight + 5s buffer
    if(nightOwlScheduleTimer) clearTimeout(nightOwlScheduleTimer);
    nightOwlScheduleTimer = setTimeout(() => { nightOwlScheduled = false; activateNightOwl(); }, midnight - now);
    // Update banner button to confirm
    const btn = document.getElementById('night-owl-btn');
    if(btn) { btn.textContent = '🦉 Set for midnight ✓'; btn.disabled = true; }
    showToast('🦉 Night Owl set — will lock onto tonight automatically at midnight');
    return;
  }
  // After midnight — lock onto yesterday's date key
  const yesterday = new Date(); yesterday.setDate(yesterday.getDate() - 1);
  nightOwlDateKey = dateKey(yesterday);
  nightOwlActive = true;
  document.getElementById('night-owl-banner').style.display = 'none';
  const activeBar = document.getElementById('night-owl-active-bar');
  activeBar.style.display = 'flex';
  const label = yesterday.toLocaleDateString('en-US', {weekday:'short', month:'short', day:'numeric'});
  document.getElementById('night-owl-date-label').textContent = label;
  showToast('🦉 Night Owl on — logging to ' + label + ' · expires 2:22 AM');
  // Auto-expire at 2:22 AM
  const expire = new Date(); expire.setHours(2, 22, 0, 0);
  if(expire <= now) expire.setDate(expire.getDate() + 1);
  if(nightOwlExpireTimer) clearTimeout(nightOwlExpireTimer);
  nightOwlExpireTimer = setTimeout(deactivateNightOwl, expire - now);
  reloadDayState();
}

function deactivateNightOwl() {
  const owlKey = nightOwlDateKey; // capture before clearing — that day is now truly over
  nightOwlActive = false;
  nightOwlDateKey = '';
  // ⚔️ Elite enforcement — the Night Owl day just ended for real
  if(owlKey && owlKey !== dateKey(new Date())) {
    const eliteFail = enforceEliteTasks(owlKey);
    const sideFail = enforceEliteSideQuests(owlKey);
    if(eliteFail || sideFail) {
      debouncedSave();
      if(eliteFail) showToast('💀 Elite Task missed — that day was lost. Tomorrow, redemption. 🐾', 5000);
      if(sideFail) showToast('💀 Elite Side Quest missed — Side Game back to square one.', 5000);
      renderSideQuests();
    }
  }
  if(nightOwlExpireTimer) { clearTimeout(nightOwlExpireTimer); nightOwlExpireTimer = null; }
