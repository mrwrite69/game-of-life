function countConsecutiveDaysWithActivity(history, keywords) {
  let streak = 0;
  const sorted = Object.keys(history).sort().reverse();
  for (const k of sorted) {
    const day = history[k];
    if (!day || !day.activities) break;
    const matched = day.activities.some(a =>
      keywords.some(kw => a.name.toLowerCase().includes(kw))
    );
    if (matched) streak++;
    else break;
  }
  return streak;
}

let currentSmartSuggestion = null;

function checkSmartMissions() {
  if (!data || !categories.length) return;
  const dismissed = JSON.parse(localStorage.getItem('smd_dismissed') || '[]');
  const banner = document.getElementById('smart-mission-banner');

  for (const pattern of SMART_PATTERNS) {
    if (dismissed.includes(pattern.id)) continue;
    // Don't suggest missions already active or completed
    if (pattern.missionId) {
      const existing = missions.find(m => m.id === pattern.missionId);
      if (existing && (existing.active || existing.completed)) continue;
    }
    const streak = pattern.test(data);
    if (streak >= 5) {
      const missionDef = pattern.missionId ? DEFAULT_MISSIONS.find(m => m.id === pattern.missionId) : null;
      currentSmartSuggestion = { pattern, streak, missionDef };
      document.getElementById('smb-icon').textContent = pattern.icon;
      document.getElementById('smb-title').textContent = pattern.label.replace('{n}', streak);
      document.getElementById('smb-desc').textContent = missionDef
        ? `${pattern.suggestion} Tap Start Mission to begin — backdated ${streak} days.`
        : pattern.suggestion;
      // Show/hide start button based on whether there's a mission to link
      const startBtn = banner.querySelector('button:first-of-type');
      if (startBtn) startBtn.style.display = missionDef ? 'block' : 'none';
      banner.style.display = 'flex';
      return; // show one at a time
    }
  }
  banner.style.display = 'none';
}

function acceptSmartMission() {
  if (!currentSmartSuggestion) return;
  const { pattern, streak, missionDef } = currentSmartSuggestion;
  if (missionDef) {
    // Start the mission backdated by streak days
    let m = missions.find(x => x.id === missionDef.id);
    if (!m) { m = { ...missionDef, active: false, startDate: null, progress: 0 }; missions.push(m); }
    const startDate = new Date();
    startDate.setDate(startDate.getDate() - streak);
    m.active = true;
    m.startDate = dateKey(startDate);
    m.progress = streak;
    m.completed = false;
    debouncedSave();
    updateMissionProgress();
    showToast(`${missionDef.icon} Mission started — backdated ${streak} days! 🎯`);
    launchFireworks(40);
  }
  dismissSmartMission();
}

function dismissSmartMission() {
  if (!currentSmartSuggestion) return;
  const dismissed = JSON.parse(localStorage.getItem('smd_dismissed') || '[]');
  if (!dismissed.includes(currentSmartSuggestion.pattern.id)) {
    dismissed.push(currentSmartSuggestion.pattern.id);
    localStorage.setItem('smd_dismissed', JSON.stringify(dismissed));
  }
  currentSmartSuggestion = null;
  document.getElementById('smart-mission-banner').style.display = 'none';
}

