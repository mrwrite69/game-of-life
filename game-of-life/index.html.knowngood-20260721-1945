    <div class="gol-splash-loading-label">LOADING<span id="gol-splash-dots"></span></div>
    <div class="gol-splash-bar-track"><div class="gol-splash-bar-fill"></div></div>
  </div>
</div>
<script>
  // Animated LOADING dots (0-3 dots, cycling)
  window.__golSplashStartTime=Date.now();
  (function(){
    var n=0;
    window.__golSplashDotsInterval=setInterval(function(){
      n=(n+1)%4;
      var el=document.getElementById('gol-splash-dots');
      if(el)el.textContent='.'.repeat(n);
      else clearInterval(window.__golSplashDotsInterval);
    },380);
  })();
  // Fades the splash out once the app signals real readiness (auth screen shown,
  // game-picker shown, or showApp() rendered) instead of relying on the bar's
  // fixed ~6.5s fill animation. Guaranteed a minimum 3s on screen even if data
  // loads instantly. Guarded so repeated calls are harmless.
  function hideLoadingScreen(){
    var el=document.getElementById('loading');
    if(!el||el.getAttribute('data-hidden')==='1')return;
    el.setAttribute('data-hidden','1');
    var elapsed=Date.now()-(window.__golSplashStartTime||Date.now());
    var remaining=Math.max(0,3000-elapsed);
    setTimeout(function(){
      el.classList.add('gol-splash-hide');
      if(window.__golSplashDotsInterval)clearInterval(window.__golSplashDotsInterval);
      setTimeout(function(){el.style.display='none';},500);
    },remaining);
  }
</script>

