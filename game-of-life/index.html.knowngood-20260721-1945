function getCapacitorLN() {
  return window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.LocalNotifications;
}
function isAndroid() {
  return !!(window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform());
}
async function requestCapacitorNotifPermission() {
  const LN = getCapacitorLN();
  if(!LN) return false;
  try {
    const { display } = await LN.checkPermissions();
    if(display === 'granted') return true;
    const result = await LN.requestPermissions();
    return result.display === 'granted';
  } catch(e) { return false; }
}
async function scheduleAndroidNotifications() {
  const LN = getCapacitorLN();
  if(!LN) return;
  // Cancel all existing GOL scheduled notifications
  try {
    const pending = await LN.getPending();
    if(pending.notifications && pending.notifications.length > 0) {
      await LN.cancel({ notifications: pending.notifications.map(n => ({id: n.id})) });
    }
  } catch(e) {}
  const notifs = [];
  const now = new Date();
  function nextFireTime(h, m) {
    const at = new Date(); at.setHours(h, m, 0, 0);
    if(at <= now) at.setDate(at.getDate() + 1);
    return at;
  }
