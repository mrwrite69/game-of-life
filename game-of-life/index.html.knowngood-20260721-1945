    const loggedToday = (todayChecked['mission_'+m.id]||0)>0 || m.lastLoggedDay===todayKey();
    const logBtn = !hasLinked ? `<button class="mission-live-log-btn${loggedToday?' logged':''}" onclick="logMissionProgress('${m.id}')">${loggedToday?'✓ Logged':'Log Today'}</button>` : '';
    card.innerHTML = `
      <div class="mission-live-top">
