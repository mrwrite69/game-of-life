// ─── UNLOCKING CALENDAR ───────────────────────────────────────────────────────
// Phase sequence: 1wk → 2wks → 4wks → 8wks → full
// Each phase unlocks after completing the previous one at 50%+ pass days

function getUnlockPhase(passDays) {
  // Returns current phase size in days and phase label
  if(passDays < 4)   return { size: 7,  label: 'Week 1 of 1 — just get started! 🐾', next: 4 };
  if(passDays < 7)   return { size: 7,  label: 'Finish your first week! 💪', next: 7 };
  if(passDays < 14)  return { size: 14, label: 'Two week challenge unlocked! 🔓', next: 14 };
  if(passDays < 28)  return { size: 28, label: 'One month view unlocked! 🌟', next: 28 };
  if(passDays < 56)  return { size: 56, label: 'Eight week view unlocked! 🚀', next: 56 };
  return { size: 999, label: 'Full calendar unlocked! 👑 You earned it!', next: 999 };
}

const ENCOURAGEMENTS = [
  "You're already halfway there — keep going! 🔥",
  "Halfway means momentum. Don't stop now! 🐾",
  "Past the halfway mark — the hard part is done! 💪",
  "More than half! Monty believes in you 👑",
  "Over halfway — Hara is cheering you on 🌸",
  "The second half is always faster. Push! ⚡",
  "You've come too far to quit now! 🎯",
];

function renderUnlockCalendar() {
  const wrap = document.getElementById('unlock-cal-wrap');
  if(!wrap) return;

  try {
    // Guard - don't render if no data at all
    if(!data || typeof data !== 'object') { wrap.innerHTML = ''; return; }
    const t = getThresholds();
    const today = new Date(); today.setHours(0,0,0,0);
    const todayStr = todayKey();

    // Find personal Day 1 — respects Start Again
    const startAgainDate = localStorage.getItem('gol-start-again-date');
    const allKeys = Object.keys(data).filter(k => data[k] && (data[k].pts > 0 || data[k].restDay)).sort();
    let day1Raw = allKeys.length > 0 ? allKeys[0] : todayStr;
    // If player hit Start Again, use that date as Day 1
    if(startAgainDate && startAgainDate > day1Raw) day1Raw = startAgainDate;
    const day1 = new Date(day1Raw + 'T00:00:00');
    day1.setHours(0,0,0,0);

    // Count total qualify days from Day 1 only (respects Start Again reset)
    const allQualifyDays = allKeys.filter(k => {
      return k >= day1Raw && data[k] && (data[k].pts >= t.pass || data[k].restDay);
    }).length;

    // Determine current phase (how many days to show)
    function getPhase(q) {
      if(q < 7)  return { size: 7,  next: 7,  nextLabel: 'Week 2' };
      if(q < 14) return { size: 14, next: 14, nextLabel: '4 Weeks' };
      if(q < 28) return { size: 28, next: 28, nextLabel: '2 Months' };
      if(q < 56) return { size: 56, next: 56, nextLabel: '3 Months' };
      return { size: 999, next: 999, nextLabel: '' };
    }
    const phase = getPhase(allQualifyDays);
    const daysToShow = phase.size === 999 ? 84 : phase.size;
    const daysToNextUnlock = phase.next - allQualifyDays;

    // Get checked-off days from localStorage
    function isDayChecked(k) {
      return localStorage.getItem('gol-daycheck-' + k) === '1';
    }

    // Count days since Day 1
    function dayNumber(d) {
      const diff = Math.floor((d - day1) / (1000*60*60*24));
      return diff + 1;
    }

    let html = '';

    // Title
    html += `<div class="unlock-cal-header">
      <div>
        <div class="unlock-cal-title">📅 Progress Calendar</div>
        <div class="unlock-cal-subtitle" style="color:var(--gold-dim)">Day 1 = ${day1.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'})} · Start Today 🤘</div>
      </div>
      <div class="unlock-cal-progress">${allQualifyDays} pass days</div>
