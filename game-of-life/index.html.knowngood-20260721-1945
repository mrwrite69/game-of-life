let encTimerInterval = null;
let encTimerSeconds = 30;
let encParticleInterval = null;

function openEncouragement() {
  const overlay = document.getElementById('enc-overlay');
  overlay.classList.add('show');
  // drum roll sound
  playDrumRoll();
  // spawn particles
  startEncParticles();
  // reset timer
  encTimerSeconds = 30;
  updateEncTimer(30, 30);
  // fetch quote
  fetchNewQuote();
  // start countdown
  if (encTimerInterval) clearInterval(encTimerInterval);
  encTimerInterval = setInterval(() => {
    encTimerSeconds--;
    updateEncTimer(encTimerSeconds, 30);
    if (encTimerSeconds <= 0) {
      clearInterval(encTimerInterval);
      // auto-close after brief pause
      setTimeout(closeEncouragement, 600);
    }
  }, 1000);
}

function closeEncouragement() {
  const overlay = document.getElementById('enc-overlay');
  overlay.classList.remove('show');
  if (encTimerInterval) { clearInterval(encTimerInterval); encTimerInterval = null; }
  if (encParticleInterval) { clearInterval(encParticleInterval); encParticleInterval = null; }
  document.getElementById('enc-particles').innerHTML = '';
}

function updateEncTimer(secs, total) {
  const numEl = document.getElementById('enc-timer-num');
  const ringEl = document.getElementById('enc-ring-fill');
  const circumference = 251.2;
  const offset = circumference * (1 - secs / total);
  numEl.textContent = Math.max(0, secs);
  ringEl.style.strokeDashoffset = offset;
  const urgent = secs <= 8;
  numEl.classList.toggle('urgent', urgent);
  ringEl.classList.toggle('urgent', urgent);
}

function startEncParticles() {
  const container = document.getElementById('enc-particles');
  container.innerHTML = '';
  const colors = ['#c8a84b','#8a6f2e','#f0d070','#ffffff','#c8a84b44'];
  function spawnParticle() {
    const p = document.createElement('div');
    p.className = 'enc-particle';
    const size = Math.random() * 6 + 3;
    const left = Math.random() * 100;
    const duration = Math.random() * 8 + 6;
    const delay = Math.random() * 2;
    p.style.cssText = `width:${size}px;height:${size}px;left:${left}%;bottom:-10px;background:${colors[Math.floor(Math.random()*colors.length)]};animation-duration:${duration}s;animation-delay:${delay}s;`;
    container.appendChild(p);
    setTimeout(() => p.remove(), (duration + delay) * 1000);
  }
  for (let i = 0; i < 20; i++) spawnParticle();
  if (encParticleInterval) clearInterval(encParticleInterval);
  encParticleInterval = setInterval(spawnParticle, 600);
}

