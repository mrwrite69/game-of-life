      <div>
        <div style="font-family:var(--font-mono);font-size:9px;color:var(--muted);margin-bottom:6px">MULTI CLICK</div>
        <button id="qp-multi-btn" type="button" onclick="qpToggleMulti()" style="width:100%;padding:7px;border-radius:8px;border:1px solid ${multiState?'var(--gold)':'var(--border)'};background:${multiState?'rgba(200,168,75,0.12)':'var(--surface)'};color:${multiState?'var(--gold)':'var(--muted)'};font-family:var(--font-mono);font-size:11px;cursor:pointer;transition:all 0.2s">
          ${multiState?'✓ Multi-click ON — tap to disable':'Multi-click OFF — tap to enable'}
