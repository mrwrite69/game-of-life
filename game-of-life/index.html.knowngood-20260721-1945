}

function completeEliteTask(id){
  const tk=todayKey();
  const d=data[tk];
  if(!d||!d.eliteTasks)return;
  const t=d.eliteTasks.find(x=>x.id===id);
  if(!t||t.done)return;
  if(d.locked){showToast('Day already finished');return;}
  if(d.eliteFailed){showToast('💀 Today is already lost. Tomorrow, redemption.');return;}
  t.done=true;
  // Award points like a side quest (custom pts, survives autosave, excluded from todayChecked)
  if(!d.activities)d.activities=[];
  d.activities.push({name:t.name,count:1,pts:t.pts,sideQuest:true,eliteTask:true});
  d.pts=calcTodayPts();
  debouncedSave();
  renderEliteTasks();
  updatePointsUI();updateLevelUI();checkAchievements();
  showToast(`⚔️ Elite Task conquered! +${t.pts}pts 👑`);
  soundPass();
  launchFireworks(30);
}

// Returns true if the day was just failed (had unfinished elite tasks)
function enforceEliteTasks(k){
  const d=data[k];
  if(!d||!Array.isArray(d.eliteTasks)||!d.eliteTasks.length)return false;
  if(d.eliteFailed)return false;
  if(!d.eliteTasks.some(t=>!t.done))return false;
  d.eliteFailed=true;
  d.failedPts=d.pts||0; // keep a record of what was lost
  d.pts=0;
  d.locked=true;
  return true;
}

// On load: any PAST day with an unfinished elite task gets failed retroactively
function enforcePastEliteTasks(){
  const todayStr=dateKey(new Date());
  let dayFailed=false;
  Object.keys(data).forEach(k=>{
    if(k>=todayStr)return; // only truly past days (YYYY-MM-DD string compare; _sideGame sorts after dates so it's skipped too)
    if(nightOwlActive&&k===nightOwlDateKey)return; // still playing that day
    if(enforceEliteTasks(k))dayFailed=true;
  });
  if(dayFailed)showToast('💀 An Elite Task was missed — that day was lost. Tomorrow, redemption. 🐾',5000);
  // ⚔️ Side Game: any quest armed for a day that already ended → side game lost
  const missedSq=sideQuests.filter(q=>q.elite&&q.armedFor&&q.armedFor<todayStr&&!(nightOwlActive&&q.armedFor===nightOwlDateKey));
  if(missedSq.length){
    const sg=getSideGame();
    sg.score=0;sg.losses+=missedSq.length;
    missedSq.forEach(q=>{q.elite=false;q.armedFor='';});
    showToast('💀 Elite Side Quest missed — Side Game back to square one.',5000);
    renderSideQuests();
  }
  if(dayFailed||missedSq.length){
    debouncedSave();
    updatePointsUI();updateLevelUI();
  }
}

// ─── SIDE QUESTS ──────────────────────────────────────────────────────────────
function addSideQuest(){
  const name=document.getElementById('sq-name-input').value.trim();
  const pts=parseInt(document.getElementById('sq-pts-input').value)||50;
  const timeframe=document.getElementById('sq-timeframe-select').value;
  if(!name){showToast('Give your quest a name! ⚡');return;}
  sideQuests.push({id:Date.now(),name,pts,timeframe,createdAt:new Date().toISOString()});
  document.getElementById('sq-name-input').value='';
  document.getElementById('sq-pts-input').value='50';
  document.getElementById('sq-pts-input-display').textContent='50';
  document.getElementById('sq-timeframe-select').value='someday';
  debouncedSave();
  renderSideQuests();
  showToast('Quest added! ⚡');
}

function completeSideQuest(id){
  const q=sideQuests.find(x=>x.id===id);
  if(!q)return;
  // Log as a custom activity to today
  const tk=todayKey();
  const wasArmed=q.elite&&q.armedFor===tk; // ⚔️ elite side quest — scores in BOTH games
  if(!data[tk])data[tk]={pts:0,activities:[],locked:false};
  if(!data[tk].activities)data[tk].activities=[];
  data[tk].activities.push({name:q.name,count:1,pts:q.pts,sideQuest:true});
  // Remove from quests
  sideQuests=sideQuests.filter(x=>x.id!==id);
  // Use calcTodayPts so combo + difficulty multipliers are respected
  data[tk].pts=calcTodayPts();
  debouncedSave();
  renderSideQuests();
  renderActivities();
  renderCompletedQuests();
  updatePointsUI();
  updateLevelUI();
  checkAchievements();
  if(wasArmed){
    const sg=getSideGame();
    sg.score+=q.pts;sg.wins++;if(sg.score>sg.best)sg.best=sg.score;
    renderSideGameBar();
    showToast(`⚔️ ELITE QUEST CONQUERED! +${q.pts} in both games — Side Game: ${sg.score} 👑`,4000);
    soundPass();
    launchFireworks(30);
  } else {
    showToast(`Quest complete! +${q.pts}pts ⚡✅`);
    soundPass();
    launchFireworks(12);
  }
}

function deleteSideQuest(id){
  sideQuests=sideQuests.filter(x=>x.id!==id);
  debouncedSave();
  renderSideQuests();
  showToast('Quest removed');
}

function renderSideQuests(){
  const list=document.getElementById('sq-list');
  if(!list)return;
  const order=['today','week','month','someday'];
  const labels={today:'📅 Today',week:'📆 This Week',month:'🗓️ This Month',someday:'🌀 Someday'};
  list.innerHTML='';
  renderSideGameBar();
  if(!sideQuests.length){
    list.innerHTML='<div class="sq-empty">No quests yet — add something to tackle! ⚡</div>';
    return;
  }
  const tk=todayKey();
  order.forEach(tf=>{
    const group=sideQuests.filter(q=>q.timeframe===tf);
    if(!group.length)return;
    const section=document.createElement('div');
    section.className='sq-section';
    section.innerHTML=`<div class="sq-section-label">${labels[tf]} — ${group.length} quest${group.length>1?'s':''}</div>`;
    group.forEach(q=>{
      const armed=q.elite&&q.armedFor===tk;
      const card=document.createElement('div');
      card.className='sq-card'+(armed?' sq-armed':'');
      card.innerHTML=`
        <div class="sq-card-info">
          <div class="sq-card-name">${armed?'⚔️ ':''}${escapeHtml(q.name)}</div>
          <div class="sq-card-meta">${armed?'<span class="sq-armed-tag">DO OR DIE · DUE TONIGHT</span>':'Added '+new Date(q.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric'})}</div>
        </div>
        <div class="sq-card-pts">+${q.pts}</div>
        <button class="sq-elite-toggle ${armed?'on':''}" onclick="toggleEliteSideQuest(${q.id})" title="${armed?'Disarm — back to a regular quest':'Arm as Elite — do or die, due tonight'}">⚔️</button>
        <button class="sq-complete-btn" onclick="completeSideQuest(${q.id})">Complete ✓</button>
        <button class="sq-delete-btn" onclick="deleteSideQuest(${q.id})" title="Delete quest">×</button>
      `;
      section.appendChild(card);
    });
    list.appendChild(section);
  });
}

// ─── ⚔️ SIDE GAME — do-or-die quest game, fully separate from the main game ──
// State lives in data._sideGame {score,best,wins,losses} (syncs + caches with days).
// Arm any active quest with the ⚔️ toggle → due by end of day (night owl respected).
// Miss it → Side Game score resets to 0. Main game untouched, always.
let sqEliteArmId=null;

function getSideGame(){
  if(!data._sideGame)data._sideGame={score:0,best:0,wins:0,losses:0};
  return data._sideGame;
}

function renderSideGameBar(){
  const bar=document.getElementById('side-game-bar');
  if(!bar)return;
  const sg=data._sideGame;
