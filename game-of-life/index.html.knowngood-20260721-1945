let animRunning=false;
function animateParticles(){animRunning=true;ctx2.clearRect(0,0,canvas.width,canvas.height);particles=particles.filter(p=>p.life>0);particles.forEach(p=>{p.x+=p.vx;p.y+=p.vy;p.vy+=0.08;p.life-=0.015;ctx2.globalAlpha=p.life;ctx2.fillStyle=p.color;ctx2.beginPath();ctx2.arc(p.x,p.y,p.size,0,Math.PI*2);ctx2.fill();});ctx2.globalAlpha=1;if(particles.length>0)requestAnimationFrame(animateParticles);else animRunning=false;}

// ─── COLOR ────────────────────────────────────────────────────────────────────
function lerpColor(a,b,t){const ah=parseInt(a.slice(1),16),bh=parseInt(b.slice(1),16);const ar=ah>>16,ag=(ah>>8)&0xff,ab=ah&0xff,br=bh>>16,bg=(bh>>8)&0xff,bb=bh&0xff;const r=Math.round(ar+(br-ar)*t),g=Math.round(ag+(bg-ag)*t),bv=Math.round(ab+(bb-ab)*t);return`#${r.toString(16).padStart(2,'0')}${g.toString(16).padStart(2,'0')}${bv.toString(16).padStart(2,'0')}`;}
function getPtsColor(pts,max){const t=Math.min(1,pts/max);if(t<0.4)return lerpColor('#886633','#c8a84b',t/0.4);if(t<0.6)return lerpColor('#c8a84b','#a0cc44',(t-0.4)/0.2);if(t<0.8)return lerpColor('#a0cc44','#44cc88',(t-0.6)/0.2);if(t<1)return lerpColor('#44cc88','#44aaff',(t-0.8)/0.2);return'#ff9933';}
function getProgressGrad(pts,max){const t=Math.min(1,pts/max);if(t<0.4)return'linear-gradient(90deg,#5a3a1a,#c8a84b)';if(t<0.6)return'linear-gradient(90deg,#c8a84b,#a0cc44)';if(t<0.8)return'linear-gradient(90deg,#a0cc44,#44cc88)';if(t<1)return'linear-gradient(90deg,#44cc88,#44aaff)';return'linear-gradient(90deg,#ff6600,#ffcc00)';}
function getStatus(pts){const t=getThresholds();if(pts>=t.elite)return{label:'🔥 TREAT YO SELF',bg:'#1a0800',color:'#ff9933',border:'#5a2800'};if(pts>=t.excellent)return{label:'⚡ HELL YA',bg:'#001520',color:'#44aaff',border:'#0d3050'};if(pts>=t.strong)return{label:'✅ STRONG DAY',bg:'#0a1500',color:'#a0cc44',border:'#223500'};if(pts>=t.pass)return{label:'✔ PASS',bg:'#001a0a',color:'#4caf7d',border:'#0d4020'};if(pts>0)return{label:pts+' / '+t.pass,bg:'#1a1200',color:'#c8a84b',border:'#3a2800'};return{label:'Lets Go!',bg:'#1a1a1a',color:'#888',border:'#2e2e2e'};}

