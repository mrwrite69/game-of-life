          continue;
        }
        const d = new Date(day1); d.setDate(day1.getDate() + i);
        d.setHours(0,0,0,0);
        const k = dateKey(d);
        const dayNum = i + 1;
        const isToday = k === todayStr;
        const isFuture = d > today;
        const dd = data[k];
        const pts = dd ? (dd.pts || 0) : 0;
        const isDayRestDay = dd && dd.restDay;
        const checked = isDayChecked(k);
        const dateLabel = d.toLocaleDateString('en-US',{month:'short',day:'numeric'});

        let level = 0;
        if(isDayRestDay) level = 0;
        else if(pts >= t.elite) level = 5;
        else if(pts >= t.excellent) level = 4;
        else if(pts >= t.strong) level = 3;
        else if(pts >= t.pass) level = 2;
        else if(pts > 0) level = 1;


        if(isFuture) {
          html += `<div class="progress-day locked${isToday?' is-today':''}">
            <span class="pd-label">Day</span>
            <span class="pd-num" style="color:#333">${dayNum}</span>
            <span class="pd-date" style="color:#222">${dateLabel}</span>
            <span class="pd-pts"></span>
          </div>`;
        } else {
          // Auto colours: green=pass, amber=miss, blue=rest, dark=empty
          const t2 = getThresholds();
          let bg, border;
          if(isDayRestDay) { bg='#0a1a2e'; border='border:1px solid #1e3a5f'; }
          else if(pts >= t2.pass) { bg='#0a1f0a'; border=isToday?'border:1.5px solid #4ade80':'border:1px solid #1a4a1a'; }
          else if(pts > 0) { bg='#1f1a00'; border=isToday?'border:1.5px solid var(--gold)':'border:1px solid #3a3000'; }
          else { bg='var(--surface)'; border=isToday?'border:1.5px solid var(--gold)':'border:1px solid var(--border)'; }
          const dayMoodVal = dd && dd.mood && dd.mood.mood;
          const moodEmojiMap = {1:'😴',2:'😔',3:'😐',4:'🙂',5:'😊',6:'🤩'};
          html += `<div class="progress-day past${isDayRestDay?' rest':''}${isToday?' is-today':''}"
            style="background:${bg};${border}"
            onclick="tapProgressDay('${k}', ${dayNum}, ${pts}, ${isDayRestDay})">
