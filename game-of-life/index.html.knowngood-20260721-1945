function getActivityStreak(actName){
  let streak=0;
  const today=new Date();
  for(let i=0;i<365;i++){
    const d=new Date(today);d.setDate(today.getDate()-i);
    const k=dateKey(d);
    const dayData=data[k];
    if(!dayData)break;
    const logged=dayData.activities&&dayData.activities.some(a=>a.name===actName&&(a.count||0)>0);
    if(!logged)break;
    streak++;
  }
  return streak;
}

