      'Make today worth remembering. 👑',
      'Progress isn\'t loud. It just shows up every day. ⚡',
    ];
    notifs.push({ id: 1004, title: '✨ 11:11',
      body: quotes[Math.floor(Math.random()*quotes.length)],
      largeIcon: 'ic_launcher', smallIcon: 'ic_stat_notify',
      schedule: { at: nextFireTime(11, 11), repeats: true, every: 'day' } });
  }
  if(notifSettings.goodnight) {
    const goodnightMsgs = [
      'Final check 🌙 Day locked in? If not — lock it, or go Night Owl 🦉',
      '11:11 PM. Last call: lock in your day, or keep playing as a Night Owl 🦉',
