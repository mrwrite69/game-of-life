let midnightTimer = null;
function scheduleMidnightSave() {
  if(midnightTimer) clearTimeout(midnightTimer);
  const now = new Date();
  const midnight = new Date(now);
  midnight.setHours(23, 59, 30, 0); // 11:59:30pm
  if(midnight <= now) midnight.setDate(midnight.getDate() + 1);
  const msUntil = midnight - now;
  midnightTimer = setTimeout(async () => {
    // Auto-save at midnight — respects Night Owl mode (saves active day, not the new date)
    const tk = todayKey(); // returns nightOwlDateKey if active, otherwise still today
    // ⚔️ Elite enforcement — if the day truly ends now (no Night Owl), missed elite tasks kill it
    const dayEnding = !nightOwlActive && !nightOwlScheduled;
    const eliteFail = dayEnding && enforceEliteTasks(tk);
    const sideFail = dayEnding && enforceEliteSideQuests(tk);
    if(eliteFail || sideFail) {
      await saveToSupabase();
      if(eliteFail) showToast('💀 Elite Task missed — day lost. Tomorrow, redemption. 🐾', 5000);
      if(sideFail) showToast('💀 Elite Side Quest missed — Side Game back to square one.', 5000);
      updatePointsUI(); updateLevelUI(); renderEliteTasks(); renderSideQuests();
      console.log('[GOL] Elite failure enforced at midnight ⚔️');
    } else if(data[tk] && data[tk].pts > 0 && !data[tk].locked) {
      await saveToSupabase();
      showToast('Auto-saved at midnight 🌙');
      console.log('[GOL] Midnight auto-save complete ✅');
    }
    scheduleMidnightSave(); // reschedule for next midnight
  }, msUntil);
}

// ─── FOREGROUND SYNC ─────────────────────────────────────────────────────────
// When app returns to foreground (tab switch, phone unlock, alt-tab),
// reload from Supabase so calendar edits from other devices appear immediately
let lastHiddenAt = null;
let lastLoadedAt = null; // set by loadFromSupabase — tracks last successful pull

async function handleForeground() {
  if(!currentUser) return;
  const now = Date.now();
  // Reload if: we were hidden for >30s, OR we haven't synced in the last 60s
  const hiddenLongEnough = lastHiddenAt && (now - lastHiddenAt > 30000);
  const staleData = !lastLoadedAt || (now - lastLoadedAt > 60000);
  if(hiddenLongEnough || staleData) {
    console.log('[GOL] App foregrounded — reloading from Supabase');
    await loadFromSupabase();
    const tk = todayKey();
    todayChecked = {};
    if(data[tk] && data[tk].activities) {
      data[tk].activities.forEach(a => { if(!a.sideQuest) todayChecked[a.name] = a.count || 1; });
      bossBattlesLogged[tk] = data[tk].bossBattles || {large:[],medium:[],small:[]};
    }
    renderActivities(); renderBossBattles(); updatePointsUI(); updateLevelUI();
    renderChallenges(); renderMissions(); updateMissionProgress();
    // Re-render whichever screen is active
    const activeScreen = document.querySelector('.screen.active');
    if(activeScreen) {
      const name = activeScreen.id.replace('screen-','');
      if(name==='calendar') renderCalendar();
      else if(name==='dashboard') renderDashboard();
      else if(name==='missions') renderMissions();
      else if(name==='sidequests') renderSideQuests();
    }
    lastHiddenAt = null;
  }
}

// visibilitychange: works on mobile + browser
document.addEventListener('visibilitychange', async () => {
  if(document.hidden) {
    lastHiddenAt = Date.now();
  } else {
    await handleForeground();
  }
});

// focus/blur: works in Electron (visibilitychange is unreliable there)
window.addEventListener('blur', () => { lastHiddenAt = Date.now(); });
window.addEventListener('focus', async () => { await handleForeground(); });

// Force-save when Electron window closes or browser tab unloads
window.addEventListener('beforeunload', () => {
  if(syncTimeout) { clearTimeout(syncTimeout); syncTimeout = null; }
  if(currentUser) saveToSupabase();
});

