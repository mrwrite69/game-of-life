// ── PIN LOGIC ─────────────────────────────────────────────────────────────────
let pinValue='';
let pinKeyboardMode=false;

function pinPress(digit){
  if(pinValue.length>=6) return;
  pinValue+=digit;
  updatePinDots();
  if(pinValue.length===6) setTimeout(handleAuth,120);
}

function pinBackspace(){
  pinValue=pinValue.slice(0,-1);
  updatePinDots();
  const kbEl=document.getElementById('auth-pin-keyboard');
  if(pinKeyboardMode) kbEl.value=pinValue;
}

function pinClear(){
  pinValue='';
  updatePinDots();
  const kbEl=document.getElementById('auth-pin-keyboard');
  if(kbEl) kbEl.value='';
}

function updatePinDots(){
  for(let i=0;i<6;i++){
    const dot=document.getElementById('pd'+i);
    dot.classList.toggle('filled', i<pinValue.length);
    dot.classList.remove('error');
  }
}

function pinError(){
  for(let i=0;i<6;i++) document.getElementById('pd'+i).classList.add('error');
  setTimeout(()=>{ pinClear(); }, 700);
}

function syncPinFromKeyboard(){
  const val=document.getElementById('auth-pin-keyboard').value.replace(/\D/g,'').slice(0,6);
  document.getElementById('auth-pin-keyboard').value=val;
  pinValue=val;
  updatePinDots();
  if(pinValue.length===6) setTimeout(handleAuth,120);
}

function togglePinKeyboard(){
  pinKeyboardMode=!pinKeyboardMode;
  const numpad=document.getElementById('pin-numpad');
  const kbEl=document.getElementById('auth-pin-keyboard');
  const hint=document.getElementById('pin-hint');
  numpad.style.display=pinKeyboardMode?'none':'grid';
  kbEl.style.display=pinKeyboardMode?'block':'none';
  hint.textContent=pinKeyboardMode?'Use numpad instead ↕':'Use keyboard instead ↕';
  if(pinKeyboardMode){ kbEl.focus(); }
  pinClear();
}

// Convert PIN to a safe password string for Supabase (never stored raw)
function pinToPassword(pin){ return 'GOL-PIN-'+pin+'-SECURE-SALT-2024'; }

// Handle physical keyboard input on auth screen
document.addEventListener('keydown', function(e){
  const authScreen=document.getElementById('auth-screen');
  if(authScreen.style.display==='none') return;
  if(pinKeyboardMode) return;
  // Don't intercept if focus is on email or name field
  const active=document.activeElement;
  if(active&&(active.id==='auth-email'||active.id==='auth-name')) return;
  if(e.key>='0'&&e.key<='9') pinPress(e.key);
  if(e.key==='Backspace') pinBackspace();
  if(e.key==='Enter'&&pinValue.length===6) handleAuth();
});

async function handleAuth(){
  const email=document.getElementById('auth-email').value.trim();
  const pin=pinValue;
  const name=document.getElementById('auth-name').value.trim();
  const btn=document.getElementById('auth-btn');
  const errEl=document.getElementById('auth-error');
  const sucEl=document.getElementById('auth-success');
  errEl.textContent='';sucEl.textContent='';
  if(!email){errEl.textContent='Please enter your email.';return;}
  if(pin.length!==6){errEl.textContent='Please enter your 6-digit PIN.';return;}
  const password=pinToPassword(pin);
  btn.disabled=true;btn.textContent='Please wait...';
  if(authMode==='signup'){
    if(!name){errEl.textContent='Please enter your name.';btn.disabled=false;btn.textContent='Create Account';return;}
    const{error}=await sb.auth.signUp({email,password,options:{data:{player_name:name}}});
    if(error){errEl.textContent=error.message;btn.disabled=false;btn.textContent='Create Account';pinError();return;}
    sucEl.textContent='Account created! Check your email to confirm, then sign in.';
    btn.disabled=false;btn.textContent='Create Account';pinClear();
  } else {
    const{data:authData,error}=await sb.auth.signInWithPassword({email,password});
    if(error){errEl.textContent='Incorrect email or PIN.';btn.disabled=false;btn.textContent='Sign In';pinError();return;}
    currentUser=authData.user;
    playerName=currentUser.user_metadata?.player_name||email.split('@')[0];
    await loadFromSupabase();
    if(!categories||!categories.length){
      document.getElementById('auth-screen').style.display='none';
      document.getElementById('game-picker').classList.add('show');
    } else {
      showApp();
    }
  }
}

