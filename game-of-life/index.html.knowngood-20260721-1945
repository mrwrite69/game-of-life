function isMissionOnTrack(m) {
  if (m.linkedActivities && m.linkedActivities.length > 0) {
    return m.linkedActivities.some(la => (todayChecked[la.name] || 0) > 0);
  }
  // todayChecked['mission_*'] is never persisted, so also check lastLoggedDay (which is saved)
  return (todayChecked['mission_'+m.id] || 0) > 0 || m.lastLoggedDay === todayKey();
}

function refreshMissionOnTrack() {
  missions.filter(m => m.active && !m.completed).forEach(m => {
    const card = document.querySelector(`.mission-live-card[data-mid="${m.id}"]`);
    if (!card) return;
    const onTrack = isMissionOnTrack(m);
    card.classList.toggle('on-track', onTrack);
    const nameEl = card.querySelector('.mission-live-name');
    const badge = card.querySelector('.mission-on-track-badge');
    if (onTrack && !badge && nameEl) {
      const b = document.createElement('span');
      b.className = 'mission-on-track-badge';
      b.textContent = '✓ done today 🎯';
      nameEl.appendChild(b);
    } else if (!onTrack && badge) {
      badge.remove();
    }
    // Update fill bar colour via class (handled by CSS)
  });
}

function renderMissionHub() {
  const hub = document.getElementById('mission-hub');
  if (!hub) return;
  const sel = document.getElementById('timer-activity-select');
  const prev = sel ? sel.value : '';
