        chip.style.cssText='background:rgba(200,168,75,0.15);border:1px solid var(--gold-dim);border-radius:6px;padding:3px 8px;font-family:var(--font-mono);font-size:9px;color:var(--gold);cursor:pointer;display:flex;align-items:center;gap:4px;';
        chip.innerHTML=`${name} <span style="color:#ff6666;font-size:11px">×</span>`;
        chip.onclick=()=>{calEditBossBattles[tier.key].splice(i,1);renderLoggedBosses();};
        logged.appendChild(chip);
      });
