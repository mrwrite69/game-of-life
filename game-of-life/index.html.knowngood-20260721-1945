async function sendNotification(title, body, subtitle='') {
  // Electron IPC (Mac app)
  if(window.electronAPI && window.electronAPI.sendNotification) {
    window.electronAPI.sendNotification({title, body, subtitle});
    return;
  }
  // Capacitor Local Notifications (Android)
  if(isAndroid()) {
    const LN = getCapacitorLN();
    if(LN) {
      try {
        await LN.schedule({ notifications: [{
          title, body,
          id: Math.floor(Math.random() * 90000) + 10000,
          largeIcon: 'ic_launcher',
          smallIcon: 'ic_stat_notify',
          schedule: { at: new Date(Date.now() + 300) }
        }]});
      } catch(e) { console.warn('sendNotification (Capacitor) failed:', e); }
      return;
    }
  }
  // Web Notifications API (browser fallback)
  if('Notification' in window) {
    if(Notification.permission === 'granted') {
      new Notification(title, {body, icon: 'assets/icon.icns'});
