    const editable=isWithin48hrs(k);
    let level=0;const t=getThresholds();if(pts>=t.elite)level=5;else if(pts>=t.excellent)level=4;else if(pts>=t.strong)level=3;else if(pts>=t.pass)level=2;else if(pts>0)level=1;
    const div=document.createElement('div');div.className=`cal-day level-${level}${isToday?' today':''}${pts>0?' has-data':''}${editable?' editable edit-indicator':''}`;
    div.innerHTML=`<span class="cal-num">${d}</span>${pts>0?`<span class="cal-pts">${pts}</span>`:''}`;
    div.onclick=()=>showDayDetail(d,dd,k,editable);
