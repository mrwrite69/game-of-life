function checkMissedDay() {
  if(missedDayPending) { showSisyphus(); return; }
  const t = getThresholds();
  const yesterday = new Date(); yesterday.setDate(yesterday.getDate()-1);
  const yk = dateKey(yesterday);
  const alreadyAsked = localStorage.getItem('gol-sisyphus-'+yk);
  if(alreadyAsked) return;
  const yd = data[yk];
  const hadActivity = yd && (yd.pts > 0 || yd.restDay || yd.locked);
  if(!hadActivity) {
    const dayBefore = new Date(); dayBefore.setDate(dayBefore.getDate()-2);
    const dbk = dateKey(dayBefore);
    const hadStreak = data[dbk] && data[dbk].pts > 0;
    if(hadStreak) {
      missedDayPending = true;
      missedDayKey = yk;
      showSisyphus();
    } else {
      localStorage.setItem('gol-sisyphus-'+yk, 'skip');
    }
  }
}

function showSisyphus() {
  const t = getThresholds();
  const streak = calcStreak();
  const totalPts = Object.values(data).reduce((s,d)=>s+(d.pts||0),0);
  const passdays = Object.values(data).filter(d=>d.pts>=t.pass).length;
  const bestDay = Math.max(0,...Object.values(data).map(d=>d.pts||0));
  const strikes = getWeeklyStrikes();
  const strikesLeft = 2 - strikes; // 0 = this is strike 3

  const el = document.getElementById('sisyphus-past-score');
  const titleEl = document.querySelector('#sisyphus-overlay .rest-day-overlay-title') ||
    document.querySelector('#sisyphus-overlay div[style*="font-heading"]');

  // Strike indicator
  const strikeDisplay = '🪨'.repeat(strikes+1) + '○'.repeat(Math.max(0, 2-strikes));

  let strikeMsgColor = '#aaaaff';
  let strikeMsg = '';
  let autoReset = false;

  if(strikes === 0) {
    strikeMsg = `Strike 1 of 3 ${strikeDisplay} — honour system, your call.`;
    strikeMsgColor = '#aaaaff';
  } else if(strikes === 1) {
    strikeMsg = `Strike 2 of 3 ${strikeDisplay} — that's 2 this week. One more and the rock rolls. 🪨`;
    strikeMsgColor = '#ffaa44';
  } else {
    strikeMsg = `Strike 3. The rock rolls back down. 🪨🪨🪨 Time to climb again.`;
    strikeMsgColor = '#ff4444';
    autoReset = true;
  }

  if(el) el.innerHTML = `
    <div style="font-family:var(--font-mono);font-size:11px;color:${strikeMsgColor};margin-bottom:8px;font-weight:700">${strikeMsg}</div>
    <strong style="color:var(--text)">Your journey so far:</strong><br>
    ${streak} day streak · ${passdays} pass days · ${totalPts.toLocaleString()} total pts<br>
    Best day: ${bestDay} pts<br><br>
    <strong style="color:var(--gold)">Let's go beat Past ${playerName||'You'}! 🐾</strong>
  `;

  // On strike 3 — hide choice buttons, show auto-reset only
  const yesBtn = document.querySelector('#sisyphus-overlay .rest-day-overlay-btn');
  const noBtn = document.querySelector('#sisyphus-overlay .rest-day-overlay-dismiss');
  if(autoReset) {
    if(yesBtn) { yesBtn.textContent = 'The rock rolls. Back to day 1. 🪨'; yesBtn.onclick = sisyphusAutoReset; }
    if(noBtn) noBtn.style.display = 'none';
  } else {
    if(yesBtn) { yesBtn.textContent = 'Yes — reset my streak 🪨'; yesBtn.onclick = sisyphusYes; yesBtn.style.background='#1a1a2e'; yesBtn.style.border='1px solid #3d3d6e'; yesBtn.style.color='#aaaaff'; }
    if(noBtn) { noBtn.style.display = 'block'; noBtn.textContent = 'Nah, I\'m good — streak stands ⚡'; noBtn.onclick = sisyphusNo; }
  }

  document.getElementById('sisyphus-overlay').classList.add('visible');
}

function sisyphusAutoReset() {
  if(missedDayKey) localStorage.setItem('gol-sisyphus-'+missedDayKey, 'auto-reset');
  missedDayPending = false;
  missedDayKey = null;
  document.getElementById('sisyphus-overlay').classList.remove('visible');
