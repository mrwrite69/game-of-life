<canvas id="fx-canvas"></canvas>
<div id="loading">
  <div class="gol-splash-grain"></div>
  <div class="gol-splash-scanlines"></div>
  <div class="gol-splash-wordmark">
    <div class="gol-splash-game">GAME</div>
    <div class="gol-splash-oflife">OF LIFE</div>
  </div>
  <div class="gol-splash-emblem">
    <div class="gol-splash-ring-outer"></div>
    <div class="gol-splash-ring-inner"></div>
