    for(let j=0;j<8;j++){const angle=Math.random()*Math.PI*2,speed=Math.random()*3+1;particles.push({x,y,vx:Math.cos(angle)*speed,vy:Math.sin(angle)*speed-2,life:1,color:col,size:Math.random()*3+1});}
  }
