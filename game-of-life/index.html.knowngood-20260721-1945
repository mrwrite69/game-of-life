function switchGame(type) {
  const oldName = categories.length ? (categories[0]._template || 'Unknown Game') : 'Unknown Game';
  const names = { seadog: "Sea Dog's Game", blank: 'Blank Slate', claudelen: "Claudelen's Game", bloodsugar: 'Blood Sugar Game', goldenyears: 'Golden Years' };
  const newName = names[type] || type;

  // Log the switch in today's data
  const tk = todayKey();
  if (!data[tk]) data[tk] = { pts: 0, activities: [], locked: false };
  data[tk].templateSwitch = `Switched to ${newName} on ${new Date().toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}`;

  // Get new template activities
  let newCats;
  if (type === 'seadog') newCats = JSON.parse(JSON.stringify(SEADOG_CATEGORIES));
  else if (type === 'blank') newCats = JSON.parse(JSON.stringify(BLANK_CATEGORIES));
  else if (type === 'bloodsugar') newCats = JSON.parse(JSON.stringify(BLOODSUGAR_CATEGORIES));
  else if (type === 'goldenyears') newCats = JSON.parse(JSON.stringify(GOLDENYEARS_CATEGORIES));
  else newCats = JSON.parse(JSON.stringify(CLAUDELEN_CATEGORIES));

  // Mark template on first category for future reference
  if (newCats.length) newCats[0]._template = newName;

  // Merge: keep existing custom activities that match names in new template
  // New template activities appear, existing ones that have history are preserved
  const existingActNames = new Set(categories.flatMap(c => c.activities.map(a => a.name)));
  newCats.forEach(cat => {
    const existingCat = categories.find(c => c.name === cat.name);
    if (existingCat) {
      // Bring over any custom-added activities not in the new template
      const newNames = new Set(cat.activities.map(a => a.name));
      existingCat.activities.filter(a => !newNames.has(a.name)).forEach(a => cat.activities.push(a));
    }
  });

  categories = newCats;
  hideSwitchGame();
  // Reset todayChecked so stale old-template activity keys don't pollute the new template's autosave
  reloadDayState();
  debouncedSave();
  showToast(`🔄 Switched to ${newName} — all progress kept! 🐾`);
  launchFireworks(25);
}

