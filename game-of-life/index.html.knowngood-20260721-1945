function toggleBossTier(tier){const el=document.getElementById(`boss-suggestions-${tier}`);el.classList.toggle('open');}

function renderBossBattles(){
  const bp=getBossPoints();
  ['large','medium','small'].forEach(tier=>{
    const container=document.getElementById(`boss-suggestions-${tier}`);
    container.innerHTML='';
    const tb=bossBattlesLogged[todayKey()]||{};
    const logged=(tb[tier]||[]);
    const all=[...BOSS_SUGGESTIONS[tier],...(tb[`custom_${tier}`]||[])];
    all.forEach(name=>{
      const done=logged.includes(name);
      const btn=document.createElement('div');btn.className='boss-suggestion'+(done?' done':'');
      btn.innerHTML=`<span>${name}</span>
        <span style="display:flex;align-items:center;gap:6px">
          <span style="font-family:var(--font-mono);font-size:9px;color:${done?'var(--green)':'var(--gold)'}">${done?'✓ +'+bp[tier]+'pts':'+'+bp[tier]}</span>
          ${done?`<button onclick="event.stopPropagation();deleteBoss('${tier}','${name}')" style="background:none;border:1px solid #3a0000;color:#ff6666;font-size:9px;padding:1px 5px;border-radius:4px;cursor:pointer;font-family:var(--font-mono)">✕</button>`:''}
