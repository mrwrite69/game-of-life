async function sendFriendRequest() {
  const input = document.getElementById('friend-email-input');
  const msg   = document.getElementById('friend-add-msg');
  const btn   = document.getElementById('friend-add-btn');
  const email = input.value.trim().toLowerCase();
  if(!email) return;
  msg.style.color = 'var(--muted)';
  msg.textContent = 'Looking up…';
  btn.disabled = true;

  try {
    // Find the user by email via game_data player_name lookup is not reliable;
    // Instead call our RPC or look up auth.users — use a workaround:
    // We store the email invite in a pending row with null friend_user_id, OR
    // we look them up via game_data where we store nothing useful.
    // Best approach: use Supabase's auth admin — not available client-side.
    // Workaround: store pending invites by email in friends table using a helper RPC.
    // For now: call the lookup_user_by_email RPC (must be created in Supabase).
    const { data: uid, error } = await sb.rpc('lookup_user_by_email', { email_input: email });
    if(error || !uid) throw new Error('User not found — make sure they have a Game of Life account.');
    if(uid === currentUser.id) throw new Error("That's you! 😄");

    // Check not already friends
    const { data: existing } = await sb.from('friends')
      .select('status').eq('user_id', currentUser.id).eq('friend_user_id', uid).maybeSingle();
    if(existing) throw new Error(existing.status === 'accepted' ? 'Already friends!' : 'Request already sent!');

    const { error: insertErr } = await sb.from('friends')
      .insert({ user_id: currentUser.id, friend_user_id: uid, status: 'pending' });
    if(insertErr) throw insertErr;

    msg.style.color = 'var(--green)';
    msg.textContent = '✓ Friend request sent!';
    input.value = '';
    setTimeout(() => { msg.textContent = ''; }, 3000);
  } catch(e) {
    msg.style.color = '#ff6666';
    msg.textContent = e.message || 'Something went wrong';
  } finally {
    btn.disabled = false;
  }
}

async function acceptFriendRequest(fromUid) {
  try {
    // Update their pending row to accepted
    await sb.from('friends').update({ status: 'accepted' })
      .eq('user_id', fromUid).eq('friend_user_id', currentUser.id);
    // Insert reciprocal row
    await sb.from('friends').upsert({ user_id: currentUser.id, friend_user_id: fromUid, status: 'accepted' },
      { onConflict: 'user_id,friend_user_id' });
    showToast('Friend accepted! 🎉');
    loadFriends();
  } catch(e) { showToast('Error accepting — try again'); }
}

async function declineFriendRequest(fromUid) {
  try {
    await sb.from('friends').delete()
      .eq('user_id', fromUid).eq('friend_user_id', currentUser.id);
    showToast('Request declined');
    loadFriends();
  } catch(e) { showToast('Error — try again'); }
}

async function removeFriend(friendUid) {
  if(!confirm('Remove this friend?')) return;
  try {
    await Promise.all([
      sb.from('friends').delete().eq('user_id', currentUser.id).eq('friend_user_id', friendUid),
      sb.from('friends').delete().eq('user_id', friendUid).eq('friend_user_id', currentUser.id),
    ]);
    showToast('Friend removed');
    loadFriends();
  } catch(e) { showToast('Error — try again'); }
}

function setFriendsPeriod(period, btn) {
  friendsPeriod = period;
  document.querySelectorAll('.friends-period-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderFriendsLeaderboard(friendsCache);
}

function switchFriendsTab(tab) {
  friendsTab = tab;
  document.getElementById('ftab-board').classList.toggle('active', tab === 'board');
  document.getElementById('ftab-requests').classList.toggle('active', tab === 'requests');
  document.getElementById('friends-board-panel').style.display    = tab === 'board'    ? 'block' : 'none';
  document.getElementById('friends-requests-panel').style.display = tab === 'requests' ? 'block' : 'none';
  document.getElementById('friends-period-row').style.display     = tab === 'board'    ? 'flex'  : 'none';
}


// ─── DOG AVATAR / PICKER (Squad Life handoff) ────────────────────────
function renderDogAvatar(){
  var dog=getPlayerDog();
  var el=document.getElementById('player-dog-avatar');
  if(!el)return;
  if(dog){el.src=dog.src;el.style.display='inline-block';}
  else{el.style.display='none';setTimeout(openDogPicker,400);}
}

function openDogPicker(){
  var grid=document.getElementById('dog-grid');
  var current=localStorage.getItem(DOG_KEY)||'';
  grid.innerHTML=DOGS.map(function(d){
    var sel=(d.id===current)?' selected':'';
    var hero=d.hero?' hero-card':'';
    var onclick="selectDog('"+d.id+"')";
    return '<div class="dog-card'+sel+hero+'" onclick="'+onclick+'">'
      +'<img src="'+d.src+'" alt="'+d.name+'" />'
      +'<div class="dog-card-name">'+d.name+(d.hero?' 🦸':'')+'</div>'
      +'</div>';
  }).join('');
  document.getElementById('dog-picker-overlay').classList.add('show');
}

function closeDogPicker(){
  document.getElementById('dog-picker-overlay').classList.remove('show');
  renderDogAvatar();
}

function selectDog(id){
  setPlayerDog(id);
  document.querySelectorAll('.dog-card').forEach(function(c){c.classList.remove('selected');});
  document.querySelectorAll('.dog-card').forEach(function(c){
    if(c.getAttribute('onclick')==="selectDog('"+id+"')")c.classList.add('selected');
  });
}

init();
</script>
<div class="dog-picker-overlay" id="dog-picker-overlay"
     onclick="if(event.target===this)closeDogPicker()">
  <div class="dog-picker-sheet" onclick="event.stopPropagation()">
    <div class="dog-picker-title">Choose your dog 🐾</div>
    <div class="dog-picker-sub">Your pup lives on your daily screen</div>
    <div class="dog-grid" id="dog-grid"></div>
    <button onclick="closeDogPicker()"
      style="width:100%;margin-top:16px;background:var(--gold);color:#000;border:none;
             border-radius:10px;padding:12px;font-family:var(--font-heading);
             font-size:14px;font-weight:800;cursor:pointer">Done</button>
  </div>
</div>
