<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Game of Life</title>
  <link rel="icon" type="image/png" href="data:image/png;base64,"/>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Space+Mono:wght@400;700&family=Syne:wght@400;700;800&display=swap" />
  <!-- Bundled locally (2026-07-17) so the app works fully offline — no CDN needed to boot -->
  <script src="assets/vendor/chart.umd.js"></script>
  <script src="assets/vendor/supabase.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --gold: #c8a84b; --gold-dim: #8a6f2e; --green: #4caf7d;
      --bg: #0f0f0f; --surface: #1a1a1a; --surface2: #242424;
      --border: #2e2e2e; --text: #f0ece0; --muted: #888;
      --font-heading: 'Syne', sans-serif; --font-mono: 'Space Mono', monospace;
    }
    html, body { height: 100%; background: var(--bg); color: var(--text); font-family: var(--font-heading); overflow-x: hidden; }
    .app { max-width: 960px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }

    /* AUTH */
    .auth-screen { position: fixed; inset: 0; background: var(--bg); display: flex; align-items: center; justify-content: center; z-index: 2000; }
    .auth-box { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 2rem; width: 100%; max-width: 380px; }
    .auth-logo { text-align: center; margin-bottom: 1.5rem; }
    .auth-logo-icon { font-size: 48px; display: block; margin-bottom: 8px; }
    .auth-logo-title { font-size: 22px; font-weight: 800; color: var(--gold); }
    .auth-logo-sub { font-family: var(--font-mono); font-size: 10px; color: var(--muted); margin-top: 4px; }
    .auth-tabs { display: flex; background: var(--surface2); border-radius: 8px; padding: 3px; margin-bottom: 1.5rem; }
    .auth-tab { flex: 1; background: none; border: none; color: var(--muted); font-family: var(--font-mono); font-size: 11px; padding: 7px; border-radius: 6px; cursor: pointer; transition: all 0.15s; text-transform: uppercase; letter-spacing: 0.05em; }
    .auth-tab.active { background: var(--surface); color: var(--gold); }
    .auth-field { margin-bottom: 12px; }
    .auth-field label { font-family: var(--font-mono); font-size: 10px; color: var(--muted); display: block; margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.08em; }
    .auth-input { width: 100%; background: var(--surface2); border: 1px solid var(--border); color: var(--text); font-family: var(--font-mono); font-size: 12px; padding: 10px 12px; border-radius: 8px; transition: border-color 0.15s; }
    .auth-input:focus { outline: none; border-color: var(--gold-dim); }
    .auth-remember { display: flex; align-items: center; gap: 8px; margin-bottom: 16px; cursor: pointer; }
    .auth-remember input { accent-color: var(--gold); }
    .auth-remember span { font-family: var(--font-mono); font-size: 10px; color: var(--muted); }
    .auth-btn { width: 100%; background: var(--gold); color: #000; font-family: var(--font-mono); font-size: 12px; font-weight: 700; border: none; border-radius: 10px; padding: 12px; cursor: pointer; text-transform: uppercase; transition: all 0.15s; margin-bottom: 10px; }
    .auth-btn:hover { background: #e0be6a; }
    .auth-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .auth-error { font-family: var(--font-mono); font-size: 10px; color: #ff6666; text-align: center; min-height: 16px; margin-bottom: 4px; }
    .auth-success { font-family: var(--font-mono); font-size: 10px; color: var(--green); text-align: center; min-height: 16px; }

    /* GAME PICKER */
    .game-picker { position: fixed; inset: 0; background: var(--bg); display: none; align-items: center; justify-content: flex-start; z-index: 1900; flex-direction: column; gap: 20px; padding: 2rem; overflow-y: auto; }
    .game-picker.show { display: flex; }
    .game-picker h1 { font-size: 26px; font-weight: 800; color: var(--gold); text-align: center; }
    .game-picker p { font-family: var(--font-mono); font-size: 11px; color: var(--muted); text-align: center; max-width: 400px; line-height: 1.8; }
    .game-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; width: 100%; max-width: 800px; }
    .game-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; cursor: pointer; transition: all 0.2s; text-align: center; }
    .game-card:hover { border-color: var(--gold-dim); transform: translateY(-2px); }
    .game-card-icon { font-size: 40px; margin-bottom: 10px; }
    .game-card-title { font-size: 16px; font-weight: 800; color: var(--gold); margin-bottom: 6px; }
    .game-card-desc { font-family: var(--font-mono); font-size: 9px; color: var(--muted); line-height: 1.7; }

    /* DIFFICULTY */
    .diff-bar { display: flex; gap: 4px; background: var(--surface2); border-radius: 8px; padding: 3px; margin-bottom: 1rem; width: fit-content; }
    .diff-btn { background: none; border: none; color: var(--muted); font-family: var(--font-mono); font-size: 10px; padding: 5px 12px; border-radius: 6px; cursor: pointer; transition: all 0.15s; }
    .diff-btn.active { color: #000; font-weight: 700; }
    .diff-btn.easy.active { background: var(--green); }
    .diff-btn.normal.active { background: var(--gold); }
    .diff-btn.hard.active { background: #ff6644; }
    .diff-btn.elite.active { background: linear-gradient(135deg, #b388ff, #7c4dff); box-shadow: 0 0 12px rgba(179,136,255,0.4); }

    /* ELITE TASKS — do or die */
    .elite-tasks-section { background: #140a0a; border: 1px solid #5a1a1a; border-radius: 14px; padding: 14px 16px; margin-bottom: 1rem; }
    .elite-tasks-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .elite-tasks-title { font-family: var(--font-heading); font-size: 13px; font-weight: 800; color: #ff6666; }
    .elite-tasks-sub { font-family: var(--font-mono); font-size: 9px; color: var(--muted); margin-top: 2px; }
    .add-elite-btn { background: #1a0808; border: 1px solid #ff4444; color: #ff6666; font-family: var(--font-mono); font-size: 10px; font-weight: 700; padding: 5px 12px; border-radius: 8px; cursor: pointer; transition: all 0.15s; white-space: nowrap; }
    .add-elite-btn:hover { background: #ff4444; color: #000; }
    .elite-task-card { display: flex; align-items: center; justify-content: space-between; gap: 10px; background: #1a0808; border: 1px solid #5a1a1a; border-radius: 10px; padding: 10px 12px; margin-top: 8px; cursor: pointer; transition: all 0.15s; }
    .elite-task-card:hover { border-color: #ff4444; }
    .elite-task-card.done { background: #0a1408; border-color: #0d4020; cursor: default; opacity: 0.85; }
    .elite-task-name { font-family: var(--font-mono); font-size: 11px; color: #eee; }
    .elite-task-card.done .elite-task-name { color: #4caf7d; }
    .elite-task-pts { font-family: var(--font-mono); font-size: 9px; color: #ff6666; white-space: nowrap; }
    .elite-task-card.done .elite-task-pts { color: #4caf7d; }
    .elite-failed-banner { font-family: var(--font-mono); font-size: 10px; color: #ff6666; background: #1a0505; border: 1px solid #5a1a1a; border-radius: 10px; padding: 10px 12px; margin-top: 8px; text-align: center; }
    .elite-confirm-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.85); display: none; align-items: center; justify-content: center; z-index: 9999; padding: 20px; }
    .elite-confirm-overlay.visible { display: flex; }
    .elite-confirm-box { background: #140a0a; border: 1px solid #ff4444; border-radius: 16px; padding: 22px; max-width: 360px; width: 100%; box-shadow: 0 0 40px rgba(255,68,68,0.25); animation: encSlideUp 0.3s cubic-bezier(.4,0,.2,1); }
    .elite-confirm-title { font-family: var(--font-heading); font-size: 18px; font-weight: 800; color: #ff6666; margin-bottom: 10px; }
    .elite-confirm-text { font-family: var(--font-mono); font-size: 10px; color: #ccc; line-height: 1.7; margin-bottom: 14px; }
    .elite-confirm-text b { color: #ff6666; }
    .elite-confirm-yes { flex: 1; background: #ff4444; color: #000; border: none; font-family: var(--font-mono); font-size: 11px; font-weight: 700; padding: 10px 14px; border-radius: 10px; cursor: pointer; }
    .elite-confirm-yes:hover { background: #ff6666; }
    .elite-confirm-no { background: none; border: 1px solid #333; color: var(--muted); font-family: var(--font-mono); font-size: 11px; padding: 10px 14px; border-radius: 10px; cursor: pointer; }

    /* ⚔️ SIDE GAME */
    .sg-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; background: #140a0a; border: 1px solid #5a1a1a; border-radius: 14px; padding: 12px 16px; margin-bottom: 1rem; }
    .sg-title { font-family: var(--font-heading); font-size: 13px; font-weight: 800; color: #ff6666; }
    .sg-sub { font-family: var(--font-mono); font-size: 9px; color: var(--muted); margin-top: 2px; }
    .sg-stats { text-align: right; }
    .sg-score { font-family: var(--font-mono); font-size: 22px; font-weight: 700; color: var(--gold); display: block; line-height: 1; }
    .sg-meta { font-family: var(--font-mono); font-size: 9px; color: var(--muted); }
    .sg-bar-empty { font-family: var(--font-mono); font-size: 9px; color: var(--muted); background: #140a0a; border: 1px dashed #5a1a1a; border-radius: 14px; padding: 10px 14px; margin-bottom: 1rem; text-align: center; line-height: 1.6; }
    .sq-elite-toggle { background: none; border: 1px solid #333; color: #555; font-size: 13px; padding: 4px 8px; border-radius: 8px; cursor: pointer; transition: all 0.15s; line-height: 1; }
    .sq-elite-toggle:hover { border-color: #ff4444; color: #ff6666; }
    .sq-elite-toggle.on { background: #ff4444; border-color: #ff4444; color: #000; box-shadow: 0 0 10px rgba(255,68,68,0.4); }
    .sq-card.sq-armed { border-color: #ff4444; background: #1a0808; }
    .sq-armed-tag { font-family: var(--font-mono); font-size: 8px; color: #ff6666; letter-spacing: 0.08em; }

    /* NAV */
    .nav { position: sticky; top: 0; z-index: 200; display: flex; flex-direction: column; margin: -1.5rem -1rem 1.5rem; padding: 0 1rem; background: rgba(8,8,8,0.92); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); border-bottom: 1px solid rgba(200,168,75,0.15); box-shadow: 0 4px 28px rgba(0,0,0,0.7); -webkit-app-region: drag; }
    .nav-tabs { display: flex; gap: 0; flex-wrap: wrap; -webkit-app-region: drag; }
    .nav-tools { display: flex; align-items: center; gap: 5px; padding: 5px 0 7px; flex-wrap: wrap; border-top: 1px solid rgba(255,255,255,0.05); -webkit-app-region: no-drag; }
    .nav-btn { -webkit-app-region: no-drag; background: none; border: none; color: var(--muted); font-family: var(--font-mono); font-size: 10px; padding: 9px 11px; cursor: pointer; letter-spacing: 0.06em; text-transform: uppercase; border-bottom: 2px solid transparent; margin-bottom: -1px; transition: all 0.2s; }
    .nav-btn.active { color: var(--gold); border-bottom-color: var(--gold); }
    .nav-btn:hover:not(.active) { color: var(--text); background: rgba(255,255,255,0.03); border-radius: 6px 6px 0 0; }
    .nav-icon-btn { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: var(--muted); font-family: var(--font-mono); font-size: 9px; padding: 3px 7px; border-radius: 5px; cursor: pointer; transition: all 0.15s; }
    .nav-icon-btn:hover { border-color: var(--gold-dim); color: var(--gold); background: rgba(200,168,75,0.08); }
    .nav-icon-btn.active { border-color: var(--gold); color: var(--gold); background: #1a1000; }
    .sync-indicator { font-family: var(--font-mono); font-size: 9px; color: var(--muted); display: flex; align-items: center; gap: 4px; margin-right: 4px; }
    .sync-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); }
    .sync-dot.syncing { background: var(--gold); animation: pulse 1s infinite; }
    .sync-dot.synced { background: var(--green); }
    .sync-dot.error { background: #ff6666; }

    .screen { display: none; } .screen.active { display: block; }

    /* LEVEL */
    .level-badge { display: flex; align-items: center; gap: 10px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 10px 14px; margin-bottom: 1rem; }
    .level-dog { font-size: 24px; }
    .level-info { flex: 1; }
    .level-name { font-size: 15px; font-weight: 800; color: var(--gold); }
    .level-sub { font-family: var(--font-mono); font-size: 9px; color: var(--muted); margin-top: 2px; }
    .level-track { height: 4px; background: var(--surface2); border-radius: 2px; margin-top: 6px; overflow: hidden; }
    .level-fill { height: 100%; background: linear-gradient(90deg, var(--gold-dim), var(--gold)); border-radius: 2px; transition: width 0.6s cubic-bezier(.4,0,.2,1); }
    .level-num { font-family: var(--font-mono); font-size: 20px; font-weight: 700; color: var(--gold); }

    /* POINTS */
    .day-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .day-header h1 { font-size: 20px; font-weight: 800; letter-spacing: -0.03em; }
    .day-header .date { font-family: var(--font-mono); font-size: 10px; color: var(--muted); margin-top: 2px; }
    .points-bar { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1rem; transition: border-color 0.5s; }
    .points-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; }
    .points-num { font-size: 36px; font-weight: 800; font-family: var(--font-mono); transition: color 0.5s; color: #555; }
    .points-label { font-family: var(--font-mono); font-size: 11px; color: var(--muted); }
    .status-badge { font-family: var(--font-mono); font-size: 10px; padding: 4px 12px; border-radius: 20px; border: 1px solid var(--border); color: var(--muted); background: var(--surface2); transition: all 0.4s; }
    .combo-badge { font-family: var(--font-mono); font-size: 10px; padding: 3px 10px; border-radius: 20px; background: #1a0a2a; border: 1px solid #5a2a8a; color: #cc88ff; display: none; }
    .combo-badge.visible { display: inline-block; animation: popIn 0.3s cubic-bezier(.4,0,.2,1); }
    .progress-track { height: 8px; background: var(--surface2); border-radius: 4px; overflow: hidden; }
    .progress-fill { height: 100%; border-radius: 4px; transition: width 0.4s cubic-bezier(.4,0,.2,1), background 0.5s; background: var(--gold-dim); }
    .progress-markers { display: flex; justify-content: space-between; margin-top: 4px; }
    .progress-markers span { font-family: var(--font-mono); font-size: 9px; color: var(--muted); }

    /* TIMER */
    .timer-block { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1rem; }
    .timer-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .timer-label { font-family: var(--font-mono); font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; }
    .timer-display { font-family: var(--font-mono); font-size: 28px; font-weight: 700; color: var(--text); }
    .timer-display.running { color: var(--green); }
    .timer-controls { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
    .timer-preset { background: var(--surface2); border: 1px solid var(--border); color: var(--muted); font-family: var(--font-mono); font-size: 10px; padding: 4px 8px; border-radius: 6px; cursor: pointer; transition: all 0.15s; }
    .timer-preset:hover, .timer-preset.active-preset { color: var(--gold); border-color: var(--gold); }
    .timer-btn { background: var(--surface2); border: 1px solid var(--border); color: var(--text); font-family: var(--font-mono); font-size: 11px; padding: 6px 14px; border-radius: 8px; cursor: pointer; }
    .timer-btn.start { border-color: var(--green); color: var(--green); }
    .timer-btn.pause { border-color: var(--gold-dim); color: var(--gold); }
    .timer-progress { height: 3px; background: var(--surface2); border-radius: 2px; margin-top: 10px; }
    .timer-progress-fill { height: 100%; background: var(--green); border-radius: 2px; transition: width 0.5s linear; }
    .timer-activity-select { background: var(--surface2); border: 1px solid var(--border); color: var(--text); font-family: var(--font-mono); font-size: 10px; padding: 4px 8px; border-radius: 6px; cursor: pointer; max-width: 180px; }

    /* ACTIVITIES */
    .category { margin-bottom: 1.5rem; }
    .cat-header { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
    .cat-label { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); border-left: 2px solid var(--gold-dim); padding-left: 8px; }
    .cat-add-btn { background: none; border: 1px dashed var(--border); color: var(--muted); font-family: var(--font-mono); font-size: 10px; padding: 2px 8px; border-radius: 6px; cursor: pointer; display: none; }
    .cat-add-btn:hover { border-color: var(--gold-dim); color: var(--gold); }
    .edit-mode .cat-add-btn { display: inline-block; }
    .activities { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 6px; }
    /* MISSION ACTIVITY CARDS */
    .mission-act-section { margin-bottom: 1rem; }
    .mission-act-header { font-family: var(--font-mono); font-size: 9px; color: #b388ff; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 6px; display: flex; align-items: center; gap: 6px; }
    .mission-act-header::before { content: ''; display: inline-block; width: 8px; height: 8px; background: #7c3aed; border-radius: 2px; }
    .act-btn.mission-card { border-color: #3d1f6e; background: #120a1f; }
    .act-btn.mission-card:hover { border-color: #7c3aed; background: #1a0f2e; }
    .act-btn.mission-card .act-name { color: #b388ff; }
    .act-btn.mission-card .act-pts { color: #9c6fe8; }
    .act-btn.mission-card.checked { background: #1a0f2e; border-color: #7c3aed; }
    .act-btn.mission-card.checked .act-name { color: #ce93d8; }
    .act-btn.mission-card .mission-tag { font-family: var(--font-mono); font-size: 8px; color: #7c3aed; background: #2d1152; border-radius: 4px; padding: 2px 6px; margin-left: 4px; white-space: nowrap; }
    .act-btn.mission-card.done-mission { border-color: var(--gold); background: #1a1400; }
    .act-btn.mission-card.done-mission .act-name { color: var(--gold); }
    .act-btn.mission-card.done-mission .mission-tag { color: var(--gold); background: #2a1f00; }
    /* LINKED ACTIVITY BUTTONS (Today tab — under mission card) */
    .mission-linked-acts { display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:5px; margin-top:6px; padding:6px 2px 2px; border-top:1px solid #2d1152; }
    .act-btn.mission-linked-btn { border-color:#3d1f6e; background:#120a1f; font-size:11px; }
    .act-btn.mission-linked-btn .act-name { color:#ce93d8; }
    .act-btn.mission-linked-btn .act-pts { color:#9c6fe8; }
    .act-btn.mission-linked-btn.checked { background:#1e0f35; border-color:#7c3aed; }
    .act-btn.mission-linked-btn.checked .act-name { color:#e1bee7; }
    /* MISSION ACTIVITY PICKER (Missions tab setup) */
    .mission-linked-picker { max-height:140px; overflow-y:auto; background:#0a0614; border:1px solid #2d1152; border-radius:8px; padding:8px 10px; margin:6px 0; }
    .linked-act-chip { display:inline-flex; align-items:center; gap:4px; background:#2d1152; border:1px solid #7c3aed; border-radius:20px; padding:3px 10px; font-family:var(--font-mono); font-size:9px; color:#ce93d8; margin:2px; }
    .linked-act-chip .chip-rm { cursor:pointer; color:#7c3aed; font-size:11px; margin-left:2px; }
    .blank-prompt { background: linear-gradient(135deg, #120a1f, #0a0f1f); border: 1px solid #3d1f6e; border-radius: 14px; padding: 1.25rem; margin-bottom: 1.5rem; text-align: center; }
    .blank-prompt-title { font-family: var(--font-heading); font-size: 16px; font-weight: 800; color: #b388ff; margin-bottom: 6px; }
    .blank-prompt-desc { font-family: var(--font-mono); font-size: 10px; color: var(--muted); line-height: 1.7; margin-bottom: 12px; }
    .blank-prompt-btn { background: #7c3aed; color: #fff; font-family: var(--font-mono); font-size: 11px; font-weight: 700; border: none; border-radius: 8px; padding: 10px 20px; cursor: pointer; transition: all 0.15s; }
    .blank-prompt-btn:hover { background: #9c5cf0; }

    /* MISSION HUB — dedicated top section on Today tab */
    .mission-hub { margin-bottom: 1.5rem; }
    .mission-hub-header { font-family: var(--font-mono); font-size: 9px; color: #e879a0; text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 10px; display: flex; align-items: center; gap: 6px; border-left: 2px solid #c026d3; padding-left: 8px; }
    .mission-live-card { background: #0f0614; border: 1px solid #4a1040; border-radius: 14px; padding: 12px 14px; margin-bottom: 8px; transition: border-color 0.3s, box-shadow 0.3s; }
    .mission-live-card.on-track { border-color: #c026d3; box-shadow: 0 0 16px rgba(192,38,211,0.28), 0 0 4px rgba(232,121,160,0.15); }
    .mission-live-top { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 8px; }
    .mission-live-icon { font-size: 22px; flex-shrink: 0; margin-top: 2px; }
    .mission-live-info { flex: 1; min-width: 0; }
    .mission-live-name { font-family: var(--font-heading); font-size: 14px; font-weight: 700; color: #e879a0; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .mission-on-track-badge { font-family: var(--font-mono); font-size: 8px; color: #e879a0; background: #2a0830; border: 1px solid #c026d3; border-radius: 20px; padding: 2px 8px; white-space: nowrap; animation: missionPulse 1.8s ease-in-out infinite; }
    @keyframes missionPulse { 0%,100%{opacity:1;box-shadow:0 0 4px rgba(192,38,211,0.4)} 50%{opacity:0.85;box-shadow:0 0 10px rgba(232,121,160,0.6)} }
    .mission-live-prog { font-family: var(--font-mono); font-size: 10px; color: var(--muted); margin-top: 3px; }
    .mission-stakes-row { display: flex; gap: 6px; margin-top: 5px; flex-wrap: wrap; }
    .mission-stake { font-family: var(--font-mono); font-size: 9px; border-radius: 20px; padding: 2px 8px; }
    .mission-stake.reward { background: #1a1200; border: 1px solid #3a2800; color: var(--gold); }
    .mission-stake.forfeit { background: #1a0a0a; border: 1px solid #3a1a1a; color: #f97316; }
    .mission-live-bar { height: 4px; background: var(--surface2); border-radius: 2px; overflow: hidden; margin-top: 4px; }
    .mission-live-fill { height: 100%; background: linear-gradient(90deg, #e879a0, #7c3aed); border-radius: 2px; transition: width 0.4s; }
    .mission-live-card.on-track .mission-live-fill { background: linear-gradient(90deg, #f472b6, #c026d3); }
    .mission-live-log-btn { flex-shrink: 0; background: #2a0830; border: 1px solid #c026d3; color: #e879a0; font-family: var(--font-mono); font-size: 10px; font-weight: 700; border-radius: 8px; padding: 6px 12px; cursor: pointer; transition: all 0.15s; white-space: nowrap; align-self: center; }
    .mission-live-log-btn:hover { background: #3d0f45; }
    .mission-live-log-btn.logged { background: #2a0830; border-color: #e879a0; color: #f9a8d4; }

    /* UNDO BUTTON */
    .undo-btn { background: none; border: 1px solid #2a2a2a; color: #555; font-family: var(--font-mono); font-size: 10px; padding: 7px 14px; border-radius: 8px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; gap: 6px; }
    .undo-btn:hover { border-color: #f97316; color: #f97316; }
    .undo-btn:disabled { opacity: 0.3; cursor: default; }

    /* HIGH SCORES */
    .highscore-wrap { background: #050505; border: 1px solid #222; border-radius: 14px; padding: 16px; margin-top: 1rem; overflow: hidden; position: relative; }
    .highscore-wrap::before { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.15) 2px, rgba(0,0,0,0.15) 4px); pointer-events: none; border-radius: 14px; }
    .highscore-title { font-family: 'Press Start 2P', monospace; font-size: 11px; color: var(--gold); text-align: center; margin-bottom: 14px; letter-spacing: 0.1em; text-shadow: 0 0 10px var(--gold-dim); animation: htFlicker 4s infinite; }
    @keyframes htFlicker { 0%,95%,100%{opacity:1} 96%,98%{opacity:0.7} }
    .highscore-row { display: flex; align-items: center; gap: 10px; padding: 7px 8px; border-radius: 8px; margin-bottom: 4px; transition: all 0.2s; position: relative; z-index: 1; }
    .highscore-row.rank-1 { background: linear-gradient(90deg, #1a1200, #2a1e00); border: 1px solid var(--gold-dim); }
    .highscore-row.rank-2 { background: #111; border: 1px solid #2a2a2a; }
    .highscore-row.rank-3 { background: #0f0f0f; border: 1px solid #222; }
    .highscore-row.rank-other { background: none; border: 1px solid transparent; }
    .hs-rank { font-family: 'Press Start 2P', monospace; font-size: 9px; width: 20px; text-align: center; flex-shrink: 0; }
    .hs-rank.r1 { color: var(--gold); animation: pulse 1.5s infinite; }
    .hs-rank.r2 { color: #aaa; }
    .hs-rank.r3 { color: #c87533; }
    .hs-rank.rother { color: #444; }
    .hs-icon { font-size: 14px; flex-shrink: 0; }
    .hs-pts { font-family: 'Press Start 2P', monospace; font-size: 10px; color: var(--gold); flex: 1; }
    .hs-pts.elite { color: #f97316; }
    .hs-pts.excellent { color: #86efac; }
    .hs-pts.strong { color: #4ade80; }
    .hs-date { font-family: var(--font-mono); font-size: 9px; color: #444; flex-shrink: 0; }
    .hs-initials { font-family: 'Press Start 2P', monospace; font-size: 8px; color: #333; flex-shrink: 0; width: 32px; text-align: right; }
    .hs-initials.r1 { color: var(--gold-dim); }
    .hs-new-score { font-family: 'Press Start 2P', monospace; font-size: 10px; color: var(--gold); text-align: center; padding: 8px; animation: letsgoFlash 0.4s infinite alternate; }

    /* REST DAY */
    .rest-day-btn { width: 100%; background: linear-gradient(135deg, #0a1a2e, #0f2040); border: 1px solid #1e3a5f; border-radius: 14px; padding: 14px 18px; display: flex; align-items: center; justify-content: space-between; gap: 12px; cursor: pointer; margin-bottom: 1rem; transition: all 0.2s; font-family: inherit; }
    .rest-day-btn:hover { border-color: #4a90d9; background: linear-gradient(135deg, #0f2040, #162850); }
    .rest-day-btn-left { display: flex; align-items: center; gap: 12px; }
    .rest-day-btn-icon { font-size: 28px; }
    .rest-day-btn-title { font-family: var(--font-heading); font-size: 15px; font-weight: 800; color: #7ec8e3; }
    .rest-day-btn-sub { font-family: var(--font-mono); font-size: 9px; color: var(--muted); margin-top: 3px; }
    .rest-day-btn-bank { font-family: var(--font-mono); font-size: 11px; color: #7ec8e3; background: #0a1a2e; border: 1px solid #1e3a5f; border-radius: 8px; padding: 6px 12px; white-space: nowrap; }
    .rest-day-overlay { position: fixed; inset: 0; z-index: 5000; background: rgba(5,5,15,0.97); display: none; align-items: center; justify-content: center; flex-direction: column; gap: 20px; text-align: center; padding: 2rem; }
    .rest-day-overlay.visible { display: flex; animation: encSlideUp 0.4s ease; }
    .rest-day-overlay-icon { font-size: 72px; animation: float 3s ease-in-out infinite; }
    @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-12px)} }
    .rest-day-overlay-title { font-family: var(--font-heading); font-size: 28px; font-weight: 900; color: #7ec8e3; }
    .rest-day-overlay-sub { font-family: var(--font-mono); font-size: 11px; color: var(--muted); max-width: 300px; line-height: 1.8; }
    .rest-day-overlay-btn { background: #7ec8e3; color: #000; font-family: var(--font-mono); font-size: 12px; font-weight: 700; border: none; border-radius: 10px; padding: 12px 28px; cursor: pointer; }
    .rest-day-overlay-dismiss { background: none; border: 1px solid var(--border); color: var(--muted); font-family: var(--font-mono); font-size: 11px; border-radius: 10px; padding: 10px 20px; cursor: pointer; }
    .rest-day-settings { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 14px; margin-bottom: 1rem; }
    .rest-day-settings-title { font-family: var(--font-mono); font-size: 9px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 10px; }

    /* NOTIFICATION SETTINGS */
    .notif-panel { position: fixed; top: 52px; right: 12px; z-index: 3000; background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 16px; width: 280px; box-shadow: 0 8px 32px rgba(0,0,0,0.6); display: none; }
    .notif-panel.visible { display: block; animation: encSlideUp 0.2s ease; }
    .notif-panel-title { font-family: var(--font-heading); font-size: 14px; font-weight: 800; color: var(--gold); margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; }
    .notif-row { display: flex; align-items: center; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #1e1e1e; }
    .notif-row:last-child { border-bottom: none; }
    .notif-row-label { font-family: var(--font-mono); font-size: 10px; color: var(--text); }
    .notif-row-sub { font-family: var(--font-mono); font-size: 9px; color: var(--muted); margin-top: 2px; }
    .notif-toggle { width: 36px; height: 20px; border-radius: 10px; border: none; cursor: pointer; position: relative; transition: background 0.2s; flex-shrink: 0; }
    .notif-toggle.on { background: var(--gold); }
    .notif-toggle.off { background: #333; }
    .notif-toggle::after { content: ''; position: absolute; top: 3px; width: 14px; height: 14px; border-radius: 50%; background: #fff; transition: left 0.2s; }
    .notif-toggle.on::after { left: 19px; }
    .notif-toggle.off::after { left: 3px; }
    .notif-time-input { background: var(--surface2); border: 1px solid var(--border); color: var(--text); font-family: var(--font-mono); font-size: 10px; padding: 4px 8px; border-radius: 6px; width: 70px; text-align: center; }

    /* QUICK POINT EDITOR */
    .quick-pts-popup { position: fixed; z-index: 4500; background: var(--surface); border: 1px solid var(--gold-dim); border-radius: 14px; padding: 14px 16px; box-shadow: 0 8px 32px rgba(0,0,0,0.7); min-width: 200px; animation: encSlideUp 0.15s ease; }
    .quick-pts-title { font-family: var(--font-mono); font-size: 9px; color: var(--muted); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.08em; }
    .quick-pts-act { font-family: var(--font-heading); font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 10px; }
    .quick-pts-btn { background: var(--surface2); border: 1px solid var(--border); color: var(--text); font-family: var(--font-mono); font-size: 18px; width: 36px; height: 36px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.1s; }
    .quick-pts-btn:hover { border-color: var(--gold); color: var(--gold); }
    .num-stepper { display: flex; align-items: center; gap: 5px; }
    .num-btn { background: #1a1200; border: 1px solid var(--gold-dim); color: var(--gold); font-family: var(--font-mono); font-size: 15px; width: 28px; height: 28px; border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.1s; flex-shrink: 0; }
    .num-btn:hover { background: var(--gold); color: #000; border-color: var(--gold); }
    .num-display { font-family: var(--font-mono); font-size: 12px; color: var(--gold); min-width: 36px; text-align: center; background: #111; border: 1px solid var(--border); border-radius: 6px; padding: 4px 6px; }
    .quick-pts-save { background: var(--gold); color: #000; font-family: var(--font-mono); font-size: 10px; font-weight: 700; border: none; border-radius: 8px; padding: 8px 16px; cursor: pointer; width: 100%; margin-top: 10px; }
    .quick-pts-dismiss { background: none; border: none; color: var(--muted); font-family: var(--font-mono); font-size: 9px; cursor: pointer; width: 100%; margin-top: 4px; padding: 4px; }

    .act-btn { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; transition: all 0.15s; text-align: left; width: 100%; position: relative; overflow: hidden; }
    .act-btn:hover { border-color: var(--gold-dim); background: var(--surface2); }
    .act-btn.checked { background: #111800; border-color: #2d4000; }
    .act-btn.checked .act-name { color: var(--green); }
    .act-btn.checked .act-pts { color: #4caf7d; }
    .act-btn.pop { animation: popIn 0.25s cubic-bezier(.4,0,.2,1); }
    .act-name { font-size: 12px; color: var(--text); flex: 1; padding-right: 8px; }
    .act-pts { font-family: var(--font-mono); font-size: 10px; color: var(--gold); white-space: nowrap; }
    .act-count { font-family: var(--font-mono); font-size: 10px; color: var(--muted); margin-left: 6px; background: var(--surface2); border-radius: 4px; padding: 1px 5px; }
    .act-streak { font-family: var(--font-mono); font-size: 9px; color: #ff8c42; background: rgba(255,107,53,0.1); border: 1px solid rgba(255,107,53,0.25); border-radius: 8px; padding: 1px 5px; margin-left: 5px; white-space: nowrap; pointer-events: none; }
    .act-edit-overlay { display: none; position: absolute; inset: 0; border-radius: 10px; background: rgba(12,12,12,0.96); padding: 7px 8px; flex-direction: column; gap: 5px; z-index: 10; }
    .edit-mode .act-edit-overlay { display: flex; }
    .edit-row { display: flex; gap: 4px; align-items: center; }
    .edit-input { background: var(--surface2); border: 1px solid var(--border); color: var(--text); font-family: var(--font-mono); font-size: 10px; padding: 3px 6px; border-radius: 5px; width: 100%; }
    .edit-save-btn { background: var(--gold); color: #000; border: none; font-family: var(--font-mono); font-size: 9px; padding: 3px 7px; border-radius: 5px; cursor: pointer; font-weight: 700; white-space: nowrap; }
    .edit-del-btn { background: #3a0000; border: 1px solid #6a0000; color: #ff6666; font-family: var(--font-mono); font-size: 9px; padding: 3px 7px; border-radius: 5px; cursor: pointer; }

    /* BOSS BATTLES */
    .boss-section { margin-top: 1.5rem; border-top: 1px solid var(--border); padding-top: 1.5rem; }
    .boss-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .boss-title { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); border-left: 2px solid #ff6644; padding-left: 8px; }
    .boss-tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 1rem; }
    .boss-tier { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 10px; }
    .boss-tier-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; cursor: pointer; }
    .boss-tier-title { font-size: 12px; font-weight: 700; }
    .boss-tier-pts { font-family: var(--font-mono); font-size: 10px; color: var(--gold); }
    .boss-tier.large .boss-tier-title { color: #ff6644; }
    .boss-tier.medium .boss-tier-title { color: var(--gold); }
    .boss-tier.small .boss-tier-title { color: var(--green); }
    .boss-suggestions { display: none; flex-direction: column; gap: 4px; margin-top: 6px; max-height: 200px; overflow-y: auto; }
    .boss-suggestions.open { display: flex; }
    .boss-suggestion { background: var(--surface2); border: 1px solid var(--border); border-radius: 8px; padding: 6px 10px; font-size: 11px; cursor: pointer; transition: all 0.15s; display: flex; justify-content: space-between; align-items: center; }
    .boss-suggestion:hover { border-color: var(--gold-dim); }
    .boss-suggestion.done { background: #111800; border-color: #2d4000; color: var(--green); }
    .boss-add-custom { background: none; border: 1px dashed var(--border); color: var(--muted); font-family: var(--font-mono); font-size: 10px; padding: 5px 10px; border-radius: 8px; cursor: pointer; width: 100%; margin-top: 6px; transition: all 0.15s; }
    .boss-add-custom:hover { border-color: var(--gold-dim); color: var(--gold); }

    /* CHALLENGES */
    .challenges-section { margin-top: 1.5rem; border-top: 1px solid var(--border); padding-top: 1.5rem; }
    .challenges-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .challenges-title { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); border-left: 2px solid var(--gold-dim); padding-left: 8px; }
    .add-challenge-btn { background: none; border: 1px dashed var(--border); color: var(--muted); font-family: var(--font-mono); font-size: 10px; padding: 4px 12px; border-radius: 8px; cursor: pointer; transition: all 0.15s; }
    .add-challenge-btn:hover { border-color: var(--gold-dim); color: var(--gold); }
    .challenge-form { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1rem; margin-bottom: 1rem; display: none; }
    .challenge-form.visible { display: block; }
    .challenge-form h3 { font-family: var(--font-mono); font-size: 11px; color: var(--gold); margin-bottom: 12px; }
    .form-row { display: flex; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
    .form-input { background: var(--surface2); border: 1px solid var(--border); color: var(--text); font-family: var(--font-mono); font-size: 11px; padding: 6px 10px; border-radius: 8px; flex: 1; min-width: 140px; }
    .form-input::placeholder { color: var(--muted); }
    .form-select { background: var(--surface2); border: 1px solid var(--border); color: var(--text); font-family: var(--font-mono); font-size: 11px; padding: 6px 10px; border-radius: 8px; cursor: pointer; }
    .form-btn { background: var(--gold); color: #000; border: none; font-family: var(--font-mono); font-size: 11px; font-weight: 700; padding: 6px 16px; border-radius: 8px; cursor: pointer; }
    .form-btn.cancel { background: var(--surface2); border: 1px solid var(--border); color: var(--muted); }
    .challenges-list { display: flex; flex-direction: column; gap: 8px; }
    .challenge-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; display: flex; align-items: center; gap: 12px; }
    .challenge-card.completed { background: #111800; border-color: #2d4000; }
    .challenge-card.failed { background: #1a0000; border-color: #4a0000; }
    .ch-info { flex: 1; }
    .ch-name { font-size: 13px; font-weight: 700; margin-bottom: 4px; }
    .ch-meta { font-family: var(--font-mono); font-size: 9px; color: var(--muted); display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
    .ch-pts-tag { padding: 2px 8px; border-radius: 10px; font-family: var(--font-mono); font-size: 9px; font-weight: 700; }
    .ch-pts-tag.bonus { background: #1a2200; color: #8fcc44; border: 1px solid #2d4000; }
    .ch-pts-tag.penalty { background: #2a0000; color: #ff6666; border: 1px solid #5a0000; }
    .ch-timer { font-family: var(--font-mono); font-size: 15px; font-weight: 700; color: var(--gold); min-width: 70px; text-align: right; }
    .ch-timer.urgent { color: #ff4444; animation: pulse 1s infinite; }
    .ch-complete-btn { background: var(--surface2); border: 1px solid var(--border); color: var(--text); font-family: var(--font-mono); font-size: 10px; padding: 5px 10px; border-radius: 8px; cursor: pointer; white-space: nowrap; }
    .ch-complete-btn:hover { border-color: var(--green); color: var(--green); }
    .ch-delete-btn { background: none; border: none; color: var(--muted); font-size: 18px; cursor: pointer; }
    .ch-delete-btn:hover { color: #ff4444; }

    /* MOOD */
    .mood-section { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1rem; }
    .mood-title { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); margin-bottom: 10px; }
    .mood-row { display: flex; gap: 8px; align-items: center; margin-bottom: 8px; }
    .mood-label { font-family: var(--font-mono); font-size: 10px; color: var(--muted); width: 60px; }
    .mood-emojis { display: flex; gap: 8px; }
    .mood-emoji { font-size: 22px; cursor: pointer; opacity: 0.35; transition: all 0.15s; border: none; background: none; padding: 2px; border-radius: 6px; }
    .mood-emoji:hover { opacity: 0.7; transform: scale(1.2); }
    .mood-emoji.selected { opacity: 1; transform: scale(1.25); filter: drop-shadow(0 0 6px rgba(200,168,75,0.6)); }
    .mood-notes { width: 100%; background: var(--surface2); border: 1px solid var(--border); color: var(--text); font-family: var(--font-mono); font-size: 11px; padding: 8px 10px; border-radius: 8px; resize: none; height: 56px; }
    .mood-notes::placeholder { color: var(--muted); }

    /* SUBMIT */
    .submit-row { margin-top: 1.5rem; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .submit-btn { background: var(--gold); color: #000; font-family: var(--font-mono); font-size: 12px; font-weight: 700; border: none; border-radius: 10px; padding: 12px 24px; cursor: pointer; text-transform: uppercase; transition: all 0.15s; }
    .submit-btn:hover { background: #e0be6a; }
    .reset-btn { background: none; border: 1px solid var(--border); color: var(--muted); font-family: var(--font-mono); font-size: 11px; padding: 12px 18px; border-radius: 10px; cursor: pointer; transition: all 0.15s; }
    .reset-btn:hover { border-color: #ff4444; color: #ff4444; }
    .submit-note { font-family: var(--font-mono); font-size: 10px; color: var(--muted); }

    /* PICKER MISSIONS */
    .picker-mission-card { background: var(--surface); border: 2px solid var(--border); border-radius: 12px; padding: 12px; cursor: pointer; transition: all 0.15s; display: flex; align-items: flex-start; gap: 10px; }
    .picker-mission-card:hover { border-color: var(--gold-dim); }
    .picker-mission-card.selected { border-color: var(--gold); background: #1a1400; }
    .picker-mission-card .pm-icon { font-size: 24px; flex-shrink: 0; }
    .picker-mission-card .pm-name { font-family: var(--font-heading); font-size: 13px; font-weight: 700; color: var(--text); }
    .picker-mission-card .pm-desc { font-family: var(--font-mono); font-size: 9px; color: var(--muted); margin-top: 3px; line-height: 1.5; }
    .picker-mission-card .pm-days { font-family: var(--font-mono); font-size: 9px; color: var(--gold-dim); margin-top: 4px; }
    .picker-mission-card.selected .pm-name::after { content: ' ✓'; color: var(--gold); }

    /* MISSIONS */
    .missions-grid { display: flex; flex-direction: column; gap: 10px; }
    .mission-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; }
    .mission-card.active-mission { border-color: #7c3aed; background: #0d0818; box-shadow: 0 0 12px rgba(124,58,237,0.2); }
    .mission-card.active-mission .mission-name { color: #b388ff; }
    .mission-card.active-mission .mission-days-tag { background: #2d1152; color: #b388ff; }
    .mission-card.completed-mission { border-color: var(--green); background: #111800; }
