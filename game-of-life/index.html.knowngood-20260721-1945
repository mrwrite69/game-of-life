    <div class="sg-stats"><span class="sg-score">${s.score}</span><span class="sg-meta">best ${s.best} · ${s.wins}W–${s.losses}L</span></div>
  </div>`;
}

function toggleEliteSideQuest(id){
  const q=sideQuests.find(x=>x.id===id);
  if(!q)return;
  const tk=todayKey();
  if(q.elite&&q.armedFor===tk){
    q.elite=false;q.armedFor='';
    debouncedSave();renderSideQuests();
    showToast('⚔️ Disarmed — back to a regular quest');
    return;
  }
  sqEliteArmId=id;
  document.getElementById('sqe-name').textContent=q.name;
